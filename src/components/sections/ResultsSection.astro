---
import SectionTitle from '../ui/SectionTitle.astro';
---

<section class="py-16 md:py-24 bg-white">
  <div class="container mx-auto px-4">
    <SectionTitle
      title="압도적인 합격률과 성적 향상"
      subtitle="대치프라임 실적"
    />
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6 text-center">
      <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
        <p id="stat-daip" class="text-2xl md:text-3xl font-bold text-brand mb-1">-명</p>
        <p id="stat-daip-label" class="text-sm font-semibold text-gray-800">2026 대입 합격</p>
        <p class="text-xs text-gray-400 mt-1">SKY·의치한 포함</p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
        <p id="stat-goip" class="text-2xl md:text-3xl font-bold text-brand mb-1">-명</p>
        <p id="stat-goip-label" class="text-sm font-semibold text-gray-800">2026 고입 합격</p>
        <p class="text-xs text-gray-400 mt-1">외고·자사고·특목고</p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
        <p id="stat-total" class="text-2xl md:text-3xl font-bold text-brand mb-1">-명</p>
        <p class="text-sm font-semibold text-gray-800">누적 대입 합격</p>
        <p class="text-xs text-gray-400 mt-1">개원 이래 전체 기준</p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
        <p class="text-2xl md:text-3xl font-bold text-brand mb-1">98%</p>
        <p class="text-sm font-semibold text-gray-800">학부모 만족도</p>
        <p class="text-xs text-gray-400 mt-1">재원생 설문 기준</p>
      </div>
    </div>
    <div class="text-center mt-10">
      <a href="/results" class="inline-block border border-gray-300 text-gray-700 text-sm font-semibold px-6 py-2.5 rounded-lg hover:bg-gray-50 transition-all">
        전체 합격/성적 실적 보기
      </a>
    </div>
  </div>
</section>

<script>
  import { supabase } from '../../lib/supabase';

  async function loadStats() {
    const daipEl = document.getElementById('stat-daip');
    const goipEl = document.getElementById('stat-goip');
    const totalEl = document.getElementById('stat-total');
    const daipLabelEl = document.getElementById('stat-daip-label');
    const goipLabelEl = document.getElementById('stat-goip-label');
    if (!daipEl || !goipEl) return;

    // 최신 연도 자동 감지
    const { data: years } = await supabase
      .from('results')
      .select('year')
      .order('year', { ascending: false })
      .limit(1);

    if (!years || years.length === 0) return;
    const latestYear = years[0].year;

    // 최신 연도 합격 수 (대입·고입)
    const { data } = await supabase
      .from('results')
      .select('category')
      .eq('year', latestYear);

    if (data) {
      const daip = data.filter(r => r.category === '대입').length;
      const goip = data.filter(r => r.category === '고입').length;
      if (daip > 0) daipEl.textContent = `${daip}명`;
      if (goip > 0) goipEl.textContent = `${goip}명`;
      if (daipLabelEl) daipLabelEl.textContent = `${latestYear} 대입 합격`;
      if (goipLabelEl) goipLabelEl.textContent = `${latestYear} 고입 합격`;
    }

    // 누적 대입 합격자 수 (전체 연도)
    if (totalEl) {
      const { count } = await supabase
        .from('results')
        .select('*', { count: 'exact', head: true })
        .eq('category', '대입');
      if (count != null && count > 0) totalEl.textContent = `${count}명`;
    }
  }

  document.addEventListener('astro:page-load', loadStats);
</script>
