---
import SectionTitle from '../ui/SectionTitle.astro';
---

<section class="py-16 md:py-24 bg-white">
  <div class="container mx-auto px-4">
    <SectionTitle
      title="압도적인 합격률과 성적 향상"
      subtitle="대치프라임 실적"
    />
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6 text-center">
      <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
        <p id="stat-daip" class="text-2xl md:text-3xl font-bold text-brand mb-1">-명</p>
        <p class="text-sm font-semibold text-gray-800">2026 대입 합격</p>
        <p class="text-xs text-gray-400 mt-1">SKY·의치한 포함</p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
        <p id="stat-goip" class="text-2xl md:text-3xl font-bold text-brand mb-1">-명</p>
        <p class="text-sm font-semibold text-gray-800">2026 고입 합격</p>
        <p class="text-xs text-gray-400 mt-1">외고·자사고·특목고</p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
        <p class="text-2xl md:text-3xl font-bold text-brand mb-1">-점</p>
        <p class="text-sm font-semibold text-gray-800">평균 성적 향상</p>
        <p class="text-xs text-gray-400 mt-1">6개월 재원 기준</p>
      </div>
      <div class="p-6 rounded-xl bg-gray-50 border border-gray-100">
        <p class="text-2xl md:text-3xl font-bold text-brand mb-1">98%</p>
        <p class="text-sm font-semibold text-gray-800">학부모 만족도</p>
        <p class="text-xs text-gray-400 mt-1">재원생 설문 기준</p>
      </div>
    </div>
    <div class="text-center mt-10">
      <a href="/results" class="inline-block border border-gray-300 text-gray-700 text-sm font-semibold px-6 py-2.5 rounded-lg hover:bg-gray-50 transition-all">
        전체 합격/성적 실적 보기
      </a>
    </div>
  </div>
</section>

<script>
  import { supabase } from '../../lib/supabase';

  async function loadStats() {
    const daipEl = document.getElementById('stat-daip');
    const goipEl = document.getElementById('stat-goip');
    if (!daipEl || !goipEl) return;

    const { data } = await supabase
      .from('results')
      .select('category')
      .eq('year', '2026');

    if (!data) return;

    const daip = data.filter(r => r.category === '대입').length;
    const goip = data.filter(r => r.category === '고입').length;

    if (daip > 0) daipEl.textContent = `${daip}명`;
    if (goip > 0) goipEl.textContent = `${goip}명`;
  }

  document.addEventListener('astro:page-load', loadStats);
</script>
