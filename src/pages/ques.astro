---
import '../styles/global.css';
import Diagnosis from '../components/Diagnosis.jsx';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>대입 전략 진단 | 대치프라임</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet" />
    <style>
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body style="background: linear-gradient(160deg, #eef0f8 0%, #f5f6fb 60%, #ebe9f4 100%); min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 1rem; font-family: 'Noto Sans KR', sans-serif;">

    <!-- 상단 브랜드 워터마크 -->
    <div class="mb-6 text-center" style="animation: fadeUp 0.4s ease-out forwards;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
        <span style="font-size: 11px; letter-spacing: 0.25em; font-weight: 600; color: #747ba2;">DC PRIME ACADEMY</span>
      </a>
      <p style="margin-top: 4px; font-size: 12px; color: #b0b5ce;">대입 전략 아키텍처 진단</p>
    </div>

    <div style="width: 100%; max-width: 560px;">
      <Diagnosis client:load />
    </div>

    <p style="margin-top: 24px; font-size: 11px; color: #c4c8dc; animation: fadeUp 0.6s ease-out forwards;">
      © 대치프라임 · 무단 복제 및 배포 금지
    </p>

  </body>
</html>
