---
import Layout from '../components/layout/Layout.astro';

const YEARS = ['2024', '2025', '2026'];
const SEMESTERS = ['1학기', '2학기'];
const TABS = YEARS.flatMap((y) => SEMESTERS.map((s) => ({ year: y, semester: s, id: `${y}-${s}` })));
---

<Layout title="성적우수자 - 대치프라임" description="대치프라임 성적우수자 명단입니다.">
  <div class="min-h-screen bg-white">

    <div class="py-14 text-center border-b border-gray-100">
      <h1 class="text-4xl font-bold text-gray-900">성적우수자</h1>
    </div>

    <div class="container mx-auto px-4 py-8 max-w-3xl">
      <div class="grid grid-cols-3 sm:grid-cols-6 border border-gray-200 rounded-sm overflow-hidden mb-10">
        {TABS.map((t, i) => (
          <button
            data-tab={t.id}
            data-year={t.year}
            data-semester={t.semester}
            class={`ts-tab py-3 text-sm font-medium border-b border-r border-gray-200 transition-colors
              ${i === TABS.length - 1 ? 'sm:border-r-0' : ''}
              ${i === 0 ? 'bg-brand text-white' : 'bg-white text-gray-500 hover:bg-gray-50'}`}
          >
            {t.year} {t.semester}
          </button>
        ))}
      </div>

      <div id="loading" class="text-center py-24 text-gray-400 text-sm">불러오는 중...</div>
      <div id="empty-msg" class="hidden text-center py-24 text-gray-400 text-sm">등록된 성적우수자가 없습니다.</div>

      <div id="photo-area" class="hidden grid grid-cols-4 gap-2 sm:gap-4 max-w-3xl mx-auto mb-14"></div>

      <div id="name-area" class="hidden"></div>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const cache: Record<string, any[]> = {};

  const DIVISION_ORDER = ['고등부', '중등부', '초등부'];
  const SUBJECT_ORDER = ['수학', '영어', '국어', '과학'];

  function groupNames(names: any[]) {
    const groups = new Map<string, { division: string; subject: string; items: any[] }>();
    for (const d of names) {
      const division = d.division || '기타';
      const subject = d.subject || '기타';
      const key = `${division}||${subject}`;
      if (!groups.has(key)) groups.set(key, { division, subject, items: [] });
      groups.get(key)!.items.push(d);
    }
    const divIndex = (v: string) => { const i = DIVISION_ORDER.indexOf(v); return i === -1 ? DIVISION_ORDER.length : i; };
    const subIndex = (v: string) => { const i = SUBJECT_ORDER.indexOf(v); return i === -1 ? SUBJECT_ORDER.length : i; };
    return [...groups.values()].sort((a, b) => {
      const dd = divIndex(a.division) - divIndex(b.division);
      if (dd !== 0) return dd;
      return subIndex(a.subject) - subIndex(b.subject);
    });
  }

  function maskName(name: string) {
    const n = String(name ?? '').trim();
    const len = n.length;
    if (len <= 1) return n;
    if (len === 2) return n[0] + 'O';
    const mid = Math.floor(len / 2);
    return n.slice(0, mid) + 'O' + n.slice(mid + 1);
  }

  async function loadTab(year: string, semester: string) {
    const key = `${year}-${semester}`;
    const loading = document.getElementById('loading')!;
    const emptyMsg = document.getElementById('empty-msg')!;
    const photoArea = document.getElementById('photo-area')!;
    const nameArea = document.getElementById('name-area')!;

    photoArea.classList.add('hidden');
    nameArea.classList.add('hidden');
    emptyMsg.classList.add('hidden');

    if (cache[key]) {
      render(cache[key]);
      return;
    }

    loading.classList.remove('hidden');

    const { data, error } = await supabase
      .from('top_scorers')
      .select('id, type, name, school, subject, grade, division, image_url')
      .eq('year', year)
      .eq('semester', semester)
      .eq('is_active', true)
      .order('sort_order', { ascending: true })
      .order('id', { ascending: true });

    loading.classList.add('hidden');

    if (error || !data || data.length === 0) {
      emptyMsg.classList.remove('hidden');
      return;
    }

    cache[key] = data;
    render(data);
  }

  function render(data: any[]) {
    const photoArea = document.getElementById('photo-area')!;
    const nameArea = document.getElementById('name-area')!;
    const emptyMsg = document.getElementById('empty-msg')!;

    const photos = data.filter(d => d.type !== 'text' && d.image_url).slice(0, 4);
    const names = data.filter(d => d.type === 'text' && d.name);

    if (photos.length === 0 && names.length === 0) {
      emptyMsg.classList.remove('hidden');
      return;
    }

    if (photos.length > 0) {
      photoArea.classList.remove('hidden');
      photoArea.innerHTML = photos.map(d => `
        <div class="rounded-xl overflow-hidden border border-gray-100 bg-gray-50">
          <div class="aspect-[210/297] bg-gray-100">
            <img src="${escAttr(d.image_url)}" alt="성적우수자" loading="lazy" decoding="async" class="w-full h-full object-cover" />
          </div>
        </div>
      `).join('');
    }

    if (names.length > 0) {
      nameArea.classList.remove('hidden');
      const groups = groupNames(names);
      nameArea.innerHTML = groups.map(g => {
        const label = [g.division !== '기타' ? g.division : '', g.subject !== '기타' ? g.subject : '']
          .filter(Boolean).join(' ') || '기타';
        const half = Math.ceil(g.items.length / 2);
        const cols = [g.items.slice(0, half), g.items.slice(half)];
        return `
          <div class="mb-10 last:mb-0">
            <h3 class="inline-block bg-gray-800 text-white text-xs sm:text-sm font-bold px-3 py-1.5 rounded-sm mb-3">
              ${escHtml(label)}
            </h3>
            <div class="grid grid-cols-2 gap-x-3 sm:gap-x-10">
              ${cols.map(col => `
                <table class="w-full text-xs sm:text-base border-t-2 border-gray-800">
                  <tbody>
                    ${col.map(d => `
                      <tr class="border-b border-gray-100">
                        <td class="py-2.5 sm:py-3.5 px-1.5 sm:px-3 text-center font-semibold text-gray-800 tracking-tight">
                          ${[d.school, maskName(d.name), d.grade].filter(Boolean).map(escHtml).join(' ')}
                        </td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              `).join('')}
            </div>
          </div>
        `;
      }).join('');
    }
  }

  function escHtml(str: string) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  function escAttr(str: string) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/"/g,'&quot;');
  }

  function init() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.ts-tab');
    if (tabs.length === 0) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('bg-brand', 'text-white');
          t.classList.add('bg-white', 'text-gray-500');
        });
        tab.classList.add('bg-brand', 'text-white');
        tab.classList.remove('bg-white', 'text-gray-500');
        loadTab(tab.dataset.year!, tab.dataset.semester!);
      });
    });

    loadTab(tabs[0].dataset.year!, tabs[0].dataset.semester!);
  }

  document.addEventListener('astro:page-load', init);
</script>
