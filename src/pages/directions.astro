---
import Layout from '../components/layout/Layout.astro';

const KAKAO_KEY = import.meta.env.PUBLIC_KAKAO_MAP_KEY;

const branches = [
  {
    id: 'neunggok',
    name: '능곡관',
    fullName: '대치프라임학원 (능곡관)',
    subjects: '초등고학년 ~ 고3 | 수학·영어·과학·국어',
    address: '경기 시흥시 장현능곡로 178',
    phone: '031-313-0979',
    lat: 37.3695611,
    lng: 126.8099174,
  },
  {
    id: 'janggok',
    name: '장곡관',
    fullName: '대치프라임장곡학원 (장곡관)',
    subjects: '초등고학년 ~ 고3 | 수학·영어·과학·국어',
    address: '경기 시흥시 장곡1로 11 4층 401, 402호',
    phone: '031-804-2495',
    lat: 37.3795718,
    lng: 126.7846255,
  },
];
---

<Layout title="찾아오시는길 - 대치프라임" description="대치프라임 능곡관·장곡관 위치 안내입니다.">

  <!-- 카카오맵 키를 DOM에 저장 (View Transitions 대응) -->
  {KAKAO_KEY && <div id="kakao-key" data-key={KAKAO_KEY} class="hidden" />}

  <div class="min-h-screen bg-white">

    <div class="border-b border-gray-200">
      <div class="container mx-auto px-4 py-8">
        <h1 class="text-2xl font-bold text-gray-900">찾아오시는길</h1>
      </div>
    </div>

    <!-- 탭 -->
    <div class="border-b border-gray-200">
      <div class="container mx-auto px-4">
        <div class="flex">
          {branches.map((b, i) => (
            <button
              data-tab={b.id}
              class={`tab-btn px-8 py-4 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap
                ${i === 0 ? 'border-brand text-brand' : 'border-transparent text-gray-400 hover:text-gray-700'}`}
            >
              {b.name} 찾아오기
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- 탭 패널 -->
    {branches.map((b, i) => (
      <div id={`panel-${b.id}`} class={`tab-panel ${i !== 0 ? 'hidden' : ''}`}>

        <!-- 지도 영역 -->
        <div
          id={`map-${b.id}`}
          class="w-full bg-gray-100"
          style="height: 420px;"
          data-lat={b.lat}
          data-lng={b.lng}
          data-name={b.fullName}
        >
          <!-- 카카오맵 키 없을 때 폴백 -->
          <div class="kakao-fallback w-full h-full flex items-center justify-center">
            <div class="text-center text-gray-400">
              <svg class="w-12 h-12 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <p class="text-sm">지도 준비 중</p>
            </div>
          </div>
        </div>

        <!-- 관 안내 -->
        <div class="container mx-auto px-4 pt-10 max-w-4xl">
          <div class="bg-brand-light rounded-2xl p-6 mb-8">
            <p class="text-xs font-semibold text-brand uppercase tracking-wide mb-1">DCPRIME</p>
            <h2 class="text-lg font-bold text-gray-900 mb-1">{b.fullName}</h2>
            <p class="text-sm text-gray-500">{b.subjects}</p>
          </div>
        </div>

        <!-- 주소 / 전화 카드 -->
        <div class="container mx-auto px-4 pb-10 max-w-4xl">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

            <div class="border border-gray-200 rounded-2xl p-6 flex flex-col items-center text-center gap-3">
              <div class="w-14 h-14 rounded-full bg-brand-light flex items-center justify-center">
                <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                    d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <p class="text-sm font-bold text-gray-800">주소</p>
              <p class="text-sm text-gray-500">{b.address}</p>
            </div>

            <div class="border border-gray-200 rounded-2xl p-6 flex flex-col items-center text-center gap-3">
              <div class="w-14 h-14 rounded-full bg-brand-light flex items-center justify-center">
                <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <p class="text-sm font-bold text-gray-800">전화번호</p>
              <a href={`tel:${b.phone.replace(/-/g, '')}`} class="text-sm text-gray-500 hover:text-brand transition-colors">{b.phone}</a>
            </div>

          </div>
        </div>

      </div>
    ))}

  </div>
</Layout>

<script>
  const mapInstances: Record<string, any> = {};

  function loadSDK(key: string): Promise<void> {
    return new Promise(resolve => {
      const win = window as any;
      if (win.kakao?.maps) { resolve(); return; }
      // 이미 삽입된 스크립트가 있으면 load 이벤트 대기
      const existing = document.querySelector<HTMLScriptElement>('script[src*="dapi.kakao.com"]');
      if (existing) {
        existing.addEventListener('load', () => resolve(), { once: true });
        return;
      }
      const s = document.createElement('script');
      s.src = `//dapi.kakao.com/v2/maps/sdk.js?appkey=${key}&autoload=false`;
      s.onload = () => resolve();
      document.head.appendChild(s);
    });
  }

  function initMaps() {
    const win = window as any;
    win.kakao.maps.load(() => {
      document.querySelectorAll<HTMLElement>('[id^="map-"]').forEach(el => {
        const id = el.id.replace('map-', '');
        if (mapInstances[id]) return; // 이미 초기화됨
        const lat = parseFloat(el.dataset.lat!);
        const lng = parseFloat(el.dataset.lng!);
        const name = el.dataset.name!;

        el.querySelector('.kakao-fallback')?.remove();

        const map = new win.kakao.maps.Map(el, {
          center: new win.kakao.maps.LatLng(lat, lng),
          level: 4,
        });
        mapInstances[id] = map;

        const marker = new win.kakao.maps.Marker({
          map,
          position: new win.kakao.maps.LatLng(lat, lng),
        });
        const infoWindow = new win.kakao.maps.InfoWindow({
          content: `<div style="padding:8px 12px;font-size:13px;font-weight:600;white-space:nowrap;">${name}</div>`,
        });
        infoWindow.open(map, marker);
      });

      // 현재 보이는 탭 지도 즉시 relayout
      const hash = location.hash.replace('#', '');
      if (hash && mapInstances[hash]) {
        mapInstances[hash].relayout();
      }
    });
  }

  function activate(id: string) {
    document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(t => {
      const on = t.dataset.tab === id;
      t.classList.toggle('border-brand', on);
      t.classList.toggle('text-brand', on);
      t.classList.toggle('border-transparent', !on);
      t.classList.toggle('text-gray-400', !on);
    });
    document.querySelectorAll<HTMLElement>('.tab-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById(`panel-${id}`)?.classList.remove('hidden');
  }

  document.addEventListener('astro:page-load', async () => {
    const key = (document.getElementById('kakao-key') as HTMLElement | null)?.dataset.key;
    if (!key) return;

    // DOM이 교체됐으므로 이전 인스턴스 초기화
    Object.keys(mapInstances).forEach(k => delete mapInstances[k]);

    // 탭 이벤트
    document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(t => {
      t.addEventListener('click', () => {
        const id = t.dataset.tab!;
        history.pushState(null, '', `#${id}`);
        activate(id);
        setTimeout(() => {
          const m = mapInstances[id];
          if (!m) return;
          m.relayout();
          const el = document.getElementById(`map-${id}`);
          if (el) {
            m.setCenter(new (window as any).kakao.maps.LatLng(
              parseFloat(el.dataset.lat!),
              parseFloat(el.dataset.lng!)
            ));
          }
        }, 50);
      });
    });

    const hash = location.hash.replace('#', '');
    if (hash) activate(hash);

    await loadSDK(key);
    initMaps();
  });
</script>
