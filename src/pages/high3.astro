                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" for="school">재학 학교 및 고교유형</label>
                        <input type="text" id="school" class="w-full px-4 py-3.5 bg-white border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-amber-600 text-sm transition-colors" placeholder="예: 대치고 (일반고 / 자사고)" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" for="interest-program">관심 있는 7월 프로그램</label>
                        <select id="interest-program" class="w-full px-4 py-3.5 bg-white border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-amber-600 text-sm transition-colors">
                            <option value="">-- 프로그램 선택 (선택 안함시 전체상담) --</option>
                            <option value="su-neung">수능최저 · 정시 대비반</option>
                            <option value="essay">고3 약술논술반</option>
                            <option value="interview">학종 면접대비반</option>
                            <option value="consulting">수시 지원 컨설팅</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" for="memo">기타 문의사항 및 내신/모의고사 성적 기록</label>
                    <textarea id="memo" rows="4" class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:border-amber-600 text-sm transition-colors" placeholder="구체적인 상황을 입력하시면 상세하고 정교한 분석 상담을 받으실 수 있습니다."></textarea>
                </div>

                <!-- Terms and Privacy -->
                <div class="flex items-start">
                    <input type="checkbox" id="terms" required class="mt-1 w-4 h-4 rounded text-amber-600 bg-white border-slate-300 focus:ring-0" />
                    <label for="terms" class="ml-2 text-xs text-slate-500">
                        개인정보 수집 및 이용 동의 (필수). 대치프라임학원은 입력하신 개인정보를 오직 입시 상담 예약 및 학원 일정 안내 목적으로만 안전하게 보관 및 활용합니다.
                    </label>
                </div>

                <p id="form-error" class="text-sm text-red-500 hidden"></p>

                <button type="submit" id="consult-submit" class="w-full py-4 rounded-xl font-bold bg-amber-600 text-white hover:bg-amber-700 transition-all shadow-lg shadow-amber-600/10 flex items-center justify-center gap-2 text-base disabled:opacity-50">
                    상담 예약 신청 및 성적 데이터 전송 <i data-lucide="send" class="w-5 h-5"></i>
                </button>
            </form>
        </div>
    </div>
</section>

<!-- Notification Popup -->
<div id="modal-container" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 hidden px-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 border border-slate-200 shadow-2xl relative text-center">
        <div class="w-16 h-16 rounded-full bg-amber-50 text-amber-600 border border-amber-200 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="check-circle-2" class="w-8 h-8"></i>
        </div>
        <h3 id="modal-title" class="text-xl font-bold text-slate-900 mb-2">신청 완료</h3>
        <p id="modal-desc" class="text-slate-600 text-sm mb-6 leading-relaxed text-left">
            학원 상담 예약 및 전송이 완료되었습니다.<br>
            담당 전담 실장이 빠른 시일 내에 기재하신 번호로 유선 연락 드려 세부 고교 유형 체크 및 대면 날짜 조율을 도와드리겠습니다.<br>
        </p>
        <button onclick="closeModal()" class="w-full py-3 rounded-xl bg-amber-600 text-white font-bold hover:bg-amber-700 transition-all text-sm">
            확인 및 돌아가기
        </button>
    </div>
</div>

<!-- UI 로직 (인라인: onclick 전역 함수 유지) -->
<script is:inline>
    lucide.createIcons();

    // D-Day Timer (2026-11-19 수능)
    function updateCountdown() {
        const currentDate = new Date();
        const targetDate = new Date('2026-11-19T08:40:00');
        const diff = targetDate - currentDate;
        if (diff <= 0) {
            ['days','hours','minutes','seconds'].forEach(u => document.getElementById('d-day-'+u).innerText = '00');
            return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / 1000 / 60) % 60);
        const seconds = Math.floor((diff / 1000) % 60);
        document.getElementById('d-day-days').innerText = String(days).padStart(2, '0');
        document.getElementById('d-day-hours').innerText = String(hours).padStart(2, '0');
        document.getElementById('d-day-minutes').innerText = String(minutes).padStart(2, '0');
        document.getElementById('d-day-seconds').innerText = String(seconds).padStart(2, '0');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // 진단 시뮬레이터
    const answers = { gpa: '', mock: '', record: '' };

    function selectOption(step, value) {
        answers[step] = value;
        const currentScreen = document.querySelector('.quiz-screen.active');
        currentScreen.querySelectorAll('.opt-btn').forEach(btn => btn.classList.remove('option-active'));
        event.currentTarget.classList.add('option-active');
        setTimeout(() => {
            if (step === 'gpa') transitionScreen('gpa', 'mock', 2);
            else if (step === 'mock') transitionScreen('mock', 'record', 3);
            else if (step === 'record') calculateResults();
        }, 350);
    }

    function transitionScreen(from, to, stepNumber) {
        document.getElementById('screen-' + from).classList.add('hidden');
        document.getElementById('screen-' + from).classList.remove('active');
        document.getElementById('screen-' + to).classList.remove('hidden');
        document.getElementById('screen-' + to).classList.add('active');
        document.querySelectorAll('.step-indicator').forEach((ind, index) => {
            if (index + 1 === stepNumber) {
                ind.classList.remove('opacity-40');
                ind.querySelector('span').className = 'w-8 h-8 rounded-full bg-amber-600 text-white font-black text-xs flex items-center justify-center shadow-md';
            }
        });
    }

    function calculateResults() {
        document.getElementById('screen-record').classList.add('hidden');
        document.getElementById('screen-record').classList.remove('active');
        document.getElementById('screen-result').classList.remove('hidden');
        document.getElementById('screen-result').classList.add('active');

        let title = '', description = '', badgeText = '', recommendedPrograms = [];

        if (answers.gpa === '1-2' && answers.record === 'excellent') {
            title = '명문대 학생부종합(학종) 합격 보장 전략';
            description = '매우 뛰어난 고교 생기부 및 우수한 내신 등급을 확보하고 계십니다.<br>이제 주안점은 수능최저 충족 여부와 면접의 밀도입니다.<br>면접 구조화와 1:1 수시 안전 설계를 병행해야 합니다.<br>';
            badgeText = '종합 전격 특화';
            recommendedPrograms = ['학종 면접대비반', '수시 지원 컨설팅', '수능최저·정시 대비반'];
        } else if (answers.gpa === '3-5' || answers.gpa === '5-under') {
            title = '약술형 논술 틈새 역전 & 수능 정시 동시 집중 전략';
            description = '현재 내신 구조상 교과 및 종합으로는 목표 인서울 대학 진입이 불리할 수 있습니다.<br>하지만 가천대 등의 약술형 논술 시험의 문항 해결 패턴을 정비하고, 동시에 6~9월 모의고사 콘텐츠로 정시 역전극을 도모하는 하이브리드 전략이 최우선입니다.<br>';
            badgeText = '역전 논술 특화';
            recommendedPrograms = ['고3 약술논술', '수능최저·정시 대비반', '시대인재 & 대성 연계 모의'];
        } else if (answers.mock === 'high' && (answers.gpa === '2-3' || answers.gpa === '3-5')) {
            title = '수능 최저 초정밀 충족 & 수시 납치 절대 차단 전략';
            description = '내신 등급에 비해 전국 모의고사 점수가 확연히 뛰어난 유형입니다.<br>무모한 하향 수시 원서 투입을 엄중히 금지해야 합니다.<br>수능에서 최고 실적을 극대화할 수 있도록 시대인재 등 프리미엄 콘텐츠 트레이닝에 몰입하길 권장합니다.<br>';
            badgeText = '정시 강세형';
            recommendedPrograms = ['수능최저·정시 대비반', '수시 지원 컨설팅', '시대인재 & 대성 연계 모의'];
        } else {
            title = '수능최저 수호 및 6원서 균형 합격 로드맵';
            description = '내신과 수능 모의 등급이 전반적으로 고른 분포를 보이고 있습니다.<br>대치프라임학원 7월 입시 종합 패키지를 통하여 3학년 1학기 최종 내신 확정 즉시 나를 위한 맞춤 원서 지원 전략 컨설팅과 정밀 대면 지도를 동시에 시작하십시오.<br>';
            badgeText = '균형 선발형';
            recommendedPrograms = ['학종 면접대비반', '수시 지원 컨설팅', '고3 약술논술'];
        }

        document.getElementById('result-badge').innerText = badgeText;
        document.getElementById('result-title').innerText = title;
        document.getElementById('result-description').innerHTML = description;
        window.__diagResult = badgeText; // DB 저장용으로 노출

        const programListContainer = document.getElementById('result-programs-list');
        programListContainer.innerHTML = '';
        recommendedPrograms.forEach(prog => {
            const div = document.createElement('div');
            div.className = 'flex items-center gap-2 px-4 py-2 bg-slate-100 rounded-xl border border-slate-200 text-xs font-bold text-slate-800';
            div.innerHTML = '<i data-lucide="check" class="w-4 h-4 text-amber-600"></i> ' + prog;
            programListContainer.appendChild(div);
        });
        lucide.createIcons();
    }

    function resetDiagnostic() {
        answers.gpa = ''; answers.mock = ''; answers.record = '';
        document.querySelectorAll('.step-indicator').forEach((ind, index) => {
            if (index > 0) {
                ind.classList.add('opacity-40');
                ind.querySelector('span').className = 'w-8 h-8 rounded-full bg-slate-200 text-slate-500 font-black text-xs flex items-center justify-center';
            }
        });
        document.getElementById('screen-result').classList.add('hidden');
        document.getElementById('screen-result').classList.remove('active');
        document.getElementById('screen-gpa').classList.remove('hidden');
        document.getElementById('screen-gpa').classList.add('active');
        document.querySelectorAll('.opt-btn').forEach(btn => btn.classList.remove('option-active'));
    }

    // 모달
    function openModal(title, desc) {
        document.getElementById('modal-title').innerText = title;
        document.getElementById('modal-desc').innerHTML = desc;
        document.getElementById('modal-container').classList.remove('hidden');
    }
    function closeModal() {
        document.getElementById('modal-container').classList.add('hidden');
    }
</script>

<!-- 상담폼 → Supabase 저장 (모듈 스크립트) -->
<script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('consultForm') as HTMLFormElement | null;
    const errorEl = document.getElementById('form-error');
    const submitBtn = document.getElementById('consult-submit') as HTMLButtonElement | null;

    const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() || '';

    const showError = (msg: string) => {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
    };

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl?.classList.add('hidden');

        const name  = val('student-name');
        const phone = val('parent-phone');
        const school = val('school') || null;
        const memo  = val('memo') || null;
        const sel = document.getElementById('interest-program') as HTMLSelectElement | null;
        const interest = sel && sel.value ? sel.options[sel.selectedIndex].text : null;
        const agree = (document.getElementById('terms') as HTMLInputElement | null)?.checked ?? false;

        if (!name || !phone) { showError('이름과 연락처를 입력해주세요.'); return; }
        if (!agree) { showError('개인정보 수집·이용에 동의해주세요.'); return; }

        if (submitBtn) submitBtn.disabled = true;

        const { error } = await supabase.from('high3_consults').insert({
            name,
            phone,
            school,
            interest_program: interest,
            memo,
            diagnostic_result: (window as any).__diagResult || null,
            agree_privacy: agree,
        });

        if (submitBtn) submitBtn.disabled = false;

        if (error) {
            showError('전송 중 오류가 발생했습니다. 잠시 후 다시 시도해주세요.');
            return;
        }

        const msg = `대치프라임학원 7월 대입 로드맵 상담 신청이 접수되었습니다.<br><br><strong>학생명:</strong> ${name}<br>${interest ? `<strong>관심 과정:</strong> ${interest}<br>` : ''}기재하신 연락처(${phone})로 담당 실장이 빠르게 연락드리겠습니다.<br>`;
        (window as any).openModal('신청 완료', msg);
        form.reset();
    });
</script>

</body>
