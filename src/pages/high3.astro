---
import '../styles/global.css';
const pageTitle = "대치프라임학원 | 고3 마지막 골든타임 - 입시 로드맵 & 진단";
---

<!DOCTYPE html>
<html lang="ko" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content="고3 마지막 골든타임. 1분 입시 방향 자가진단과 대치프라임학원 7월 입시 로드맵 · 1:1 상담 신청." />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <!-- Google Fonts: Inter & Noto Sans KR -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest" is:inline></script>
    <style is:global>
        body {
            font-family: 'Noto Sans KR', 'Inter', sans-serif;
            background-color: #ffffff;
        }
        .gradient-gold {
            background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
        }
        .gradient-premium {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        }
        .text-gradient-gold {
            background: linear-gradient(135deg, #D97706 0%, #B45309 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .glow-gold {
            box-shadow: 0 4px 20px rgba(217, 119, 6, 0.15);
        }
        .light-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        }
        .option-active {
            border-color: #D97706 !important;
            background-color: rgba(217, 119, 6, 0.05) !important;
            color: #B45309 !important;
        }
    </style>
</head>
<body class="text-slate-800 antialiased overflow-x-hidden">

<!-- Navigation Header (Light Theme Optimized) -->
<header class="fixed top-0 left-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-slate-200 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div>
                <a href="/" class="text-lg sm:text-xl font-black tracking-wider text-slate-900">대치프라임학원</a>
                <span class="block text-[10px] text-slate-500 -mt-1 tracking-widest">고3 마지막 골든타임</span>
            </div>
        </div>
        <div>
            <a href="#diagnostic" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-amber-600 text-white hover:bg-amber-700 transition-all shadow-md hover:shadow-amber-600/20">
                기초진단하기 <i data-lucide="sparkles" class="w-4 h-4"></i>
            </a>
        </div>
    </div>
</header>

<!-- Hero Section (Intro) -->
<section id="intro" class="relative pt-32 pb-20 md:pt-44 md:pb-28 overflow-hidden bg-white">
    <div class="absolute inset-0 z-0">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-amber-500/5 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-10 left-10 w-[300px] h-[300px] bg-blue-500/5 rounded-full blur-[100px]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(rgba(0,0,0,0.015)_1px,transparent_1px)] [background-size:16px_16px]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold tracking-widest bg-amber-500/10 text-amber-700 border border-amber-500/20 mb-6 uppercase">
            <i data-lucide="alarm-clock" class="w-3.5 h-3.5"></i> 고3 대입지원 마지막 골든타임
        </span>

        <h1 class="text-3xl sm:text-6xl font-black text-slate-900 tracking-tight leading-none mb-6">
            입시는 <span class="text-gradient-gold">끝까지</span>,<br class="sm:hidden" /> 전략은 <span class="underline decoration-amber-600 decoration-wavy underline-offset-8">정교하게</span>
        </h1>

        <div class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed mb-10 font-medium">
            [공지] 고3, 마지막 골든타임: 입시는 끝까지, 전략은 정교하게.<br>
            - 하단에 본인의 대입 지원전략을 체크해볼 수 있는 링크가 있으니 주의깊게 보세요.<br><br>
            고3 여러분, 1학기 기말고사를 앞둔 마지막 골든타임입니다.<br>
            당장 눈앞의 등급 하나가 힘들겠지만,<br>
            지금 쏟는 땀방울이 9월 원서 접수 때 가장 강력한 자산이 됩니다.<br>
            끝날 때까지는 끝난 것이 아닙니다.<br>
            <span class="text-xl sm:text-2xl font-black text-gradient-gold block mt-3">모든 것을 쏟아부으십시오.</span>
        </div>

        <!-- D-Day Countdown -->
        <div class="max-w-xl mx-auto bg-slate-50 rounded-2xl p-6 mb-12 border border-slate-200 shadow-lg relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-500 to-amber-600"></div>
            <p class="text-xs sm:text-sm font-bold tracking-widest text-slate-500 mb-4 uppercase">2026년 11월 19일 (목) 대입 수능 시험</p>
            <div class="grid grid-cols-4 gap-2 sm:gap-4">
                <div class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200">
                    <span id="d-day-days" class="block text-2xl sm:text-4xl font-extrabold text-amber-600">00</span>
                    <span class="text-[10px] sm:text-xs text-slate-400 font-bold uppercase tracking-wider">DAYS</span>
                </div>
                <div class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200">
                    <span id="d-day-hours" class="block text-2xl sm:text-4xl font-extrabold text-slate-800">00</span>
                    <span class="text-[10px] sm:text-xs text-slate-400 font-bold uppercase tracking-wider">HOURS</span>
                </div>
                <div class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200">
                    <span id="d-day-minutes" class="block text-2xl sm:text-4xl font-extrabold text-slate-800">00</span>
                    <span class="text-[10px] sm:text-xs text-slate-400 font-bold uppercase tracking-wider">MINS</span>
                </div>
                <div class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200">
                    <span id="d-day-seconds" class="block text-2xl sm:text-4xl font-extrabold text-amber-600">00</span>
                    <span class="text-[10px] sm:text-xs text-slate-400 font-bold uppercase tracking-wider">SECS</span>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="#diagnostic" class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold bg-amber-600 text-white hover:bg-amber-700 transition-all shadow-lg shadow-amber-600/15 transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                나의 입시방향 1분 진단하기 <i data-lucide="arrow-right" class="w-5 h-5"></i>
            </a>
            <a href="#roadmap" class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold bg-slate-100 border border-slate-200 text-slate-700 hover:bg-slate-200 transition-all flex items-center justify-center gap-2">
                7월 로드맵 일정 확인 <i data-lucide="calendar" class="w-5 h-5"></i>
            </a>
        </div>
    </div>
</section>

<!-- Interactive Diagnostic Simulator Section -->
<section id="diagnostic" class="py-20 bg-slate-50 border-t border-b border-slate-200 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-12">
            <span class="text-amber-600 font-bold tracking-widest text-xs uppercase block mb-3">DIAGNOSTIC SIMULATOR</span>
            <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
                내 입시 방향 <span class="text-amber-600">자가 진단기</span>
            </h2>
            <div class="text-slate-500 text-sm sm:text-base mt-4 leading-relaxed">
                중요: 내 입시 방향, 진단해 보세요.<br>
                아래 링크를 통해 나의 내신과 수능 경쟁력, 생기부 방향을 먼저 진단해 보길 바랍니다.<br>
                본인에게 가장 유리한 전형과 보완해야 할 점을 미리 파악하는 것이 입시 성공의 시작입니다.<br>
                대치프라임학원 합격 분석 데이터가 최적의 지원 전략을 도출합니다.<br>
            </div>
        </div>

        <!-- Simulator Container -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xl">
            <!-- Step Indicators -->
            <div class="flex items-center justify-between mb-8 pb-6 border-b border-slate-100">
                <div class="flex items-center gap-2 step-indicator" data-step="1">
                    <span class="w-8 h-8 rounded-full bg-amber-600 text-white font-black text-xs flex items-center justify-center shadow-md">1</span>
                    <span class="text-xs sm:text-sm font-bold text-slate-800 hidden sm:inline">내신 등급</span>
                </div>
                <div class="h-0.5 bg-slate-200 flex-1 mx-4"></div>
                <div class="flex items-center gap-2 step-indicator opacity-40" data-step="2">
                    <span class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 font-black text-xs flex items-center justify-center">2</span>
                    <span class="text-xs sm:text-sm font-bold text-slate-500 hidden sm:inline">모의고사 성적</span>
                </div>
                <div class="h-0.5 bg-slate-200 flex-1 mx-4"></div>
                <div class="flex items-center gap-2 step-indicator opacity-40" data-step="3">
                    <span class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 font-black text-xs flex items-center justify-center">3</span>
                    <span class="text-xs sm:text-sm font-bold text-slate-500 hidden sm:inline">생기부 준비도</span>
                </div>
            </div>

            <!-- Quiz Screens Container -->
            <div id="quiz-screens">
                <!-- SCREEN 1: GPA -->
                <div id="screen-gpa" class="quiz-screen active">
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <span class="w-1.5 h-6 bg-amber-600 rounded-full inline-block"></span>
                        현재 본인의 3학년 1학기 예상 포함 평균 내신 등급은?
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <button onclick="selectOption('gpa', '1-2')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-amber-600">1.0등급 ~ 2.0등급 이하</span>
                                <span class="font-bold text-base sm:text-lg">학생부 교과 및 종합 상위권 목표</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('gpa', '2-3')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-amber-600">2.1등급 ~ 3.5등급 이하</span>
                                <span class="font-bold text-base sm:text-lg">서울/수도권 종합 및 주력 전형</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('gpa', '3-5')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-amber-600">3.6등급 ~ 5.0등급 이하</span>
                                <span class="font-bold text-base sm:text-lg">약술형 논술 및 적성, 정시 병행</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('gpa', '5-under')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-amber-600">5.0등급 이하</span>
                                <span class="font-bold text-base sm:text-lg">수능/정시 올인 또는 논술 전형</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-5 h-5 opacity-40"></i>
                        </button>
                    </div>
                </div>

                <!-- SCREEN 2: Mock Exam -->
                <div id="screen-mock" class="quiz-screen hidden">
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <span class="w-1.5 h-6 bg-amber-600 rounded-full inline-block"></span>
                        6월 평가원 혹은 모의고사 국어·수학·탐구 평균 등급은?
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <button onclick="selectOption('mock', 'high')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-amber-600">평균 1.5등급 이내</span>
                                <span class="font-bold text-base sm:text-lg">수능 최저 완벽 충족 & 정시 탑클래스</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('mock', 'mid-high')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-amber-600">평균 2 ~ 3등급 이내</span>
                                <span class="font-bold text-base sm:text-lg">인서울 수능 최저 충족 주력군</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('mock', 'mid')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-amber-600">평균 3.5 ~ 4.5등급 이내</span>
                                <span class="font-bold text-base sm:text-lg">약술형 논술 및 수시 교과 타겟</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('mock', 'low')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-amber-600">평균 5등급 이하</span>
                                <span class="font-bold text-base sm:text-lg">기본기 강화 및 최저 기준 확보 목표</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-5 h-5 opacity-40"></i>
                        </button>
                    </div>
                </div>

                <!-- SCREEN 3: School Record -->
                <div id="screen-record" class="quiz-screen hidden">
                    <h3 class="text-lg sm:text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <span class="w-1.5 h-6 bg-amber-600 rounded-full inline-block"></span>
                        본인의 학생부 세특 및 동아리 등 생기부 기록 수준은?
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <button onclick="selectOption('record', 'excellent')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-emerald-600 font-bold">우수 (A등급)</span>
                                <span class="font-bold text-base sm:text-lg">전공적합성 뚜렷, 교과세특 풍부</span>
                            </div>
                            <i data-lucide="check-circle" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('record', 'average')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-sky-600 font-bold">보통 (B등급)</span>
                                <span class="font-bold text-base sm:text-lg">기본 활동 있음, 3학년 보완 필요</span>
                            </div>
                            <i data-lucide="check-circle" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('record', 'poor')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-slate-500 font-bold">미흡/없음 (C등급)</span>
                                <span class="font-bold text-base sm:text-lg">교과 공부 집중으로 생기부 미약</span>
                            </div>
                            <i data-lucide="check-circle" class="w-5 h-5 opacity-40"></i>
                        </button>
                        <button onclick="selectOption('record', 'unsure')" class="opt-btn flex items-center justify-between p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-all text-left text-slate-700">
                            <div>
                                <span class="block text-xs font-semibold text-rose-600 font-bold">잘 모르겠음</span>
                                <span class="font-bold text-base sm:text-lg">객관적인 평가가 선행되어야 함</span>
                            </div>
                            <i data-lucide="check-circle" class="w-5 h-5 opacity-40"></i>
                        </button>
                    </div>
                </div>

                <!-- SCREEN 4: RESULTS -->
                <div id="screen-result" class="quiz-screen hidden text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-500/10 text-amber-600 border border-amber-500/20 mb-6 glow-gold">
                        <i data-lucide="trending-up" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 mb-2">분석 완료!<br>대입 합격 솔루션</h3>
                    <p class="text-slate-500 text-sm mb-6">입력한 성적 데이터와 합격 패턴을 조합해 분석된 맞춤 전략입니다.</p>

                    <!-- Dynamic Feedback Card -->
                    <div class="bg-slate-50 rounded-2xl p-6 sm:p-8 text-left border border-slate-200 mb-8 max-w-2xl mx-auto">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="px-3 py-1 bg-amber-600 text-white font-bold rounded-full text-xs" id="result-badge">추천 전략</span>
                            <span class="text-slate-500 text-xs font-semibold" id="result-score-summary">분석 신뢰도 98%</span>
                        </div>
                        <h4 class="text-xl sm:text-2xl font-black text-slate-900 mb-3" id="result-title">수시 최저 확보 및 정시 올인 집중반 추천</h4>
                        <p class="text-slate-600 text-sm leading-relaxed mb-6" id="result-description">
                            현재 수능 모의고사 경쟁력이 내신에 비해 월등히 양호합니다.<br>
                            최상위권 대학의 학생부 교과/종합 수능 최저학력기준을 완벽하게 맞춤과 동시에 원치 않는 '수시 납치'를 극비리에 철저 차단하는 고정밀 원서 조합 전략이 절실합니다.<br>
                        </p>

                        <div class="border-t border-slate-200 pt-6">
                            <h5 class="text-xs font-extrabold tracking-wider text-amber-700 uppercase mb-4">수강을 강력 권장하는 대치프라임학원 프로그램</h5>
