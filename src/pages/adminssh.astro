      .order('sort_order', { ascending: true })
      .order('created_at', { ascending: true });
    if (error) {
      container.innerHTML = `<p class="col-span-full text-sm text-red-400 py-4 text-center">불러오기 오류: ${escHtml(error.message)}</p>`;
      return;
    }
    if (!data || data.length === 0) {
      container.innerHTML = '<p class="col-span-full text-sm text-gray-400 py-4 text-center">등록된 사진이 없습니다.</p>';
      return;
    }
    container.innerHTML = data.map(p => `
      <div class="border border-gray-200 rounded-xl overflow-hidden">
        <div class="aspect-[4/3] bg-gray-100">
          <img src="${escAttr(p.image_url || '')}" alt="${escAttr(p.caption || '')}" class="w-full h-full object-cover" onerror="this.style.opacity='0.2'" />
        </div>
        <div class="p-3">
          <p class="text-sm font-medium text-gray-800 truncate">${escHtml(p.caption || '(캡션 없음)')} ${p.is_active ? '' : '<span class="text-xs text-gray-400 font-normal">(숨김)</span>'}</p>
          <p class="text-xs text-gray-400 mb-2">순서 ${p.sort_order}</p>
          <div class="flex gap-3">
            <button data-id="${p.id}" data-campus="${escAttr(p.campus)}" data-caption="${escAttr(p.caption ?? '')}"
              data-sort="${p.sort_order}" data-active="${p.is_active ? '1' : '0'}" data-image="${escAttr(p.image_url ?? '')}"
              class="edit-space-btn text-xs text-blue-400 hover:text-blue-600 transition-colors">수정</button>
            <button data-id="${p.id}" class="del-space-btn text-xs text-red-400 hover:text-red-600 transition-colors">삭제</button>
          </div>
        </div>
      </div>
    `).join('');

    container.querySelectorAll<HTMLButtonElement>('.edit-space-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        spaceEditId = btn.dataset.id!;
        (document.getElementById('space-campus-input') as HTMLSelectElement).value = btn.dataset.campus ?? 'neunggok';
        (document.getElementById('space-caption-input') as HTMLInputElement).value = btn.dataset.caption ?? '';
        (document.getElementById('space-sort-input') as HTMLInputElement).value = btn.dataset.sort ?? '0';
        (document.getElementById('space-active-input') as HTMLInputElement).checked = btn.dataset.active === '1';
        const preview = document.getElementById('space-image-preview') as HTMLImageElement;
        if (btn.dataset.image) { preview.src = btn.dataset.image; preview.classList.remove('hidden'); }
        document.getElementById('space-form-title')!.textContent = '교육환경 사진 수정';
        document.getElementById('submit-space-btn')!.textContent = '수정 완료';
        document.getElementById('cancel-space-btn')!.classList.remove('hidden');
        document.getElementById('space-form-title')!.scrollIntoView({ behavior: 'smooth' });
      });
    });

    container.querySelectorAll<HTMLButtonElement>('.del-space-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('이 사진을 삭제할까요?')) return;
        await supabase.from('space_photos').delete().eq('id', btn.dataset.id!);
        loadSpacePhotos((document.getElementById('space-list-filter') as HTMLSelectElement).value);
      });
    });
  }

  document.getElementById('space-image-input')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const preview = document.getElementById('space-image-preview') as HTMLImageElement;
      preview.src = ev.target?.result as string;
      preview.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  });

  document.getElementById('space-list-filter')?.addEventListener('change', (e) => {
    loadSpacePhotos((e.target as HTMLSelectElement).value);
