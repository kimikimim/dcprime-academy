  document.getElementById('submit-ts-bulk-btn')?.addEventListener('click', async () => {
    const year     = (document.getElementById('ts-bulk-year-input') as HTMLSelectElement).value;
    const semester = (document.getElementById('ts-bulk-semester-input') as HTMLSelectElement).value;
    const fileInput = document.getElementById('ts-bulk-input') as HTMLInputElement;
    const files = fileInput.files
      ? Array.from(fileInput.files).filter(f => f.type.startsWith('image/') || isPdfFile(f))
      : [];
    const msg = document.getElementById('ts-bulk-msg')!;
    const progressWrap = document.getElementById('ts-bulk-progress')!;
    const progressBar = document.getElementById('ts-bulk-progress-bar')!;
    const progressText = document.getElementById('ts-bulk-progress-text')!;

    if (files.length === 0) {
      msg.textContent = '사진이 담긴 폴더(또는 사진 여러 장)를 선택하세요.'; msg.classList.remove('hidden');
      setTimeout(() => msg.classList.add('hidden'), 3000);
      return;
    }

    // 파일명 기준 정렬 (1.jpg, 2.jpg ... 순서 보장)
    files.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));

    // 현재 해당 년도/학기의 마지막 순서 다음부터 이어서 저장
    const { data: existing } = await supabase
      .from('top_scorers')
      .select('sort_order')
      .eq('year', year)
      .eq('semester', semester)
      .order('sort_order', { ascending: false })
      .limit(1);
    let nextSort = (existing && existing[0] ? existing[0].sort_order : 0) + 1;

    const btn = document.getElementById('submit-ts-bulk-btn') as HTMLButtonElement;
    btn.disabled = true;
    progressWrap.classList.remove('hidden');
    msg.classList.add('hidden');

    let successCount = 0;
    let failCount = 0;

    for (let i = 0; i < files.length; i++) {
      let file = files[i];
      progressText.textContent = `${i + 1} / ${files.length} 업로드 중... (${file.name})`;
      progressBar.style.width = `${Math.round(((i) / files.length) * 100)}%`;

      if (isPdfFile(file)) {
        progressText.textContent = `${i + 1} / ${files.length} pdf 변환 중... (${file.name})`;
        try {
          file = await pdfFirstPageToImageFile(file);
        } catch {
          failCount++;
          continue;
        }
      }

      const ext = file.name.split('.').pop();
      const path = `ts-bulk-${Date.now()}-${i}.${ext}`;
      const { error: upErr } = await supabase.storage.from('top-scorers-images').upload(path, file);

      if (upErr) {
        failCount++;
      } else {
        const { data: urlData } = supabase.storage.from('top-scorers-images').getPublicUrl(path);
        const { error: insErr } = await supabase.from('top_scorers').insert({
          year, semester, image_url: urlData.publicUrl, sort_order: nextSort, is_active: true,
        });
        if (insErr) failCount++; else successCount++;
        nextSort++;
      }
    }

    progressBar.style.width = '100%';
    progressText.textContent = `완료: ${successCount}장 업로드${failCount > 0 ? `, ${failCount}장 실패` : ''}`;
    btn.disabled = false;
    fileInput.value = '';
    msg.textContent = `${successCount}장 업로드되었습니다.${failCount > 0 ? ` (${failCount}장 실패)` : ''}`;
    msg.classList.remove('hidden');

    (document.getElementById('ts-list-year-filter') as HTMLSelectElement).value = year;
    (document.getElementById('ts-list-semester-filter') as HTMLSelectElement).value = semester;
    loadTopScorers();
  });

