      return;
    }
    container.innerHTML = data.map(r => `
      <div class="py-3 flex items-center gap-4">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-900">${escHtml(r.grade)} · ${escHtml(r.subject)}</p>
          <p class="text-xs text-gray-400 truncate">${escHtml(r.scope ?? '')} ${r.difficulty_level ? '· ' + escHtml(r.difficulty_level) : ''}</p>
        </div>
