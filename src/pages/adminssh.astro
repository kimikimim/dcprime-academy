<div id="download-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-6">
    <h3 class="text-lg font-bold text-gray-900 mb-1">신청 목록 다운로드</h3>
    <p class="text-sm text-gray-500 mb-5">다운로드할 프로그램을 선택하세요. (엑셀 .xlsx)</p>
    <div id="download-source-list" class="space-y-2"></div>
    <button id="download-close" class="mt-5 w-full py-2.5 rounded-lg bg-gray-100 text-gray-600 text-sm font-semibold hover:bg-gray-200 transition-colors">닫기</button>
  </div>
</div>

<!-- SheetJS (엑셀 생성, 관리자 페이지에서만 로드) -->
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js" is:inline></script>

<script>
  import { supabase } from '../lib/supabase';

  const SESSION_KEY = 'dcprime_admin';
  const ALL_TABS = ['hero', 'notices', 'inquiries', 'about', 'curriculum', 'faculty', 'results'];

  // ── 신청 목록 다운로드 소스 레지스트리 ──
  // 새 프로그램 추가 시 아래 배열에 1개 항목만 추가하면 됩니다.
  //   table: Supabase 테이블명 / columns: [엑셀헤더, 행→값 함수]
  const fmtDateTime = (v: string) => {
    if (!v) return '';
    const d = new Date(v);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  };

  const DOWNLOAD_SOURCES: {
    key: string; label: string; table: string; order: string;
    columns: [string, (r: any) => any][];
  }[] = [
    {
      key: 'high3', label: '고3 상담 신청', table: 'high3_consults', order: 'created_at',
      columns: [
        ['신청일시', r => fmtDateTime(r.created_at)],
        ['이름', r => r.name],
        ['연락처', r => r.phone],
        ['학교/유형', r => r.school],
        ['관심 프로그램', r => r.interest_program],
        ['진단 결과', r => r.diagnostic_result],
        ['문의사항', r => r.memo],
        ['개인정보 동의', r => (r.agree_privacy ? 'Y' : 'N')],
        ['상태', r => r.status],
      ],
    },
    {
      key: 'ques', label: '대입 전략 진단', table: 'diagnosis_logs', order: 'created_at',
      columns: [
        ['일시', r => fmtDateTime(r.created_at)],
        ['내신등급', r => r.path?.answers?.gpa],
        ['모의등급', r => r.path?.answers?.mock],
        ['생기부', r => r.path?.answers?.record],
        ['약술과목', r => r.path?.answers?.yaksul_subject],
        ['결과 태그', r => r.result_tag],
      ],
    },
    {
      key: 'seminar', label: '설명회 신청', table: 'seminar_bookings', order: 'created_at',
      columns: [
        ['신청일시', r => fmtDateTime(r.created_at)],
        ['캠퍼스', r => r.campus],
        ['이름', r => r.name],
        ['학년', r => r.grade],
        ['연락처', r => r.phone],
        ['문의사항', r => r.memo],
        ['개인정보 동의', r => (r.agree_privacy ? 'Y' : 'N')],
        ['상태', r => r.status],
      ],
    },
  ];
  const ABOUT_SUBS = ['greeting', 'history', 'features'];
  const CUR_SUBS = ['elementary', 'middle', 'high'];

  const quills: Record<string, any> = {};
  const tabInited = new Set<string>();

  // ── 유틸 ──
  function isLoggedIn() { return sessionStorage.getItem(SESSION_KEY) === 'ok'; }

  function escHtml(str: string) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function escAttr(str: string) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/"/g,'&quot;');
  }

  // ── Quill 로드 ──
  async function loadQuillLib() {
    if ((window as any).Quill) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css';
    document.head.appendChild(link);
    await new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js';
      script.onload = () => resolve();
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  function createQuill(containerId: string, placeholder = '내용을 입력하세요.', bucket = 'notice-images') {
    if (quills[containerId]) return quills[containerId];
    const Quill = (window as any).Quill;
    const q = new Quill(`#${containerId}`, {
      theme: 'snow',
      modules: {
        toolbar: {
          container: [
            [{ header: [1, 2, 3, false] }],
            ['bold', 'italic', 'underline'],
            [{ color: [] }],
            [{ align: [] }],
            ['link', 'image'],
            ['clean'],
          ],
          handlers: {
            image: () => {
              const input = document.createElement('input');
              input.type = 'file';
              input.accept = 'image/*';
              input.click();
              input.onchange = async () => {
                const file = input.files?.[0];
                if (!file) return;
                const ext = file.name.split('.').pop();
                const path = `${Date.now()}.${ext}`;
                const { data, error } = await supabase.storage.from(bucket).upload(path, file, { upsert: true });
                if (!error && data) {
                  const { data: urlData } = supabase.storage.from(bucket).getPublicUrl(path);
                  const range = q.getSelection(true);
                  q.insertEmbed(range.index, 'image', urlData.publicUrl);
                  q.setSelection(range.index + 1);
                }
              };
            },
          },
        },
      },
      placeholder,
    });
    quills[containerId] = q;
    return q;
  }

  // ── page_content 로드/저장 ──
  async function loadPageContent(key: string, qid: string) {
    const { data } = await supabase.from('page_content').select('value').eq('key', key).single();
    const q = quills[qid];
    if (q && data?.value) {
      const delta = q.clipboard.convert({ html: data.value });
      q.setContents(delta);
    }
  }

  async function savePageContent(key: string, qid: string) {
    const q = quills[qid];
    if (!q) return;
    const value = q.root.innerHTML;
    const { error } = await supabase
      .from('page_content')
      .upsert({ key, value, updated_at: new Date().toISOString() });
    const msgEl = document.getElementById(`msg-${key}`);
    if (msgEl) {
      msgEl.textContent = error ? '오류: ' + error.message : '저장되었습니다.';
      msgEl.classList.remove('hidden');
      setTimeout(() => msgEl.classList.add('hidden'), 3000);
    }
  }

  // ── 메인 탭 ──
  function switchMainTab(tab: string) {
    document.querySelectorAll<HTMLButtonElement>('.admin-tab').forEach(t => {
      const active = t.dataset.tab === tab;
      t.classList.toggle('border-brand', active);
      t.classList.toggle('text-brand', active);
      t.classList.toggle('border-transparent', !active);
      t.classList.toggle('text-gray-400', !active);
    });
    ALL_TABS.forEach(p => {
      document.getElementById(`panel-${p}`)?.classList.toggle('hidden', p !== tab);
    });
    if (!tabInited.has(tab)) {
      tabInited.add(tab);
      if (tab === 'about')      initAboutTab();
      if (tab === 'curriculum') initCurriculumTab();
      if (tab === 'hero')       loadHeroSlides();
      if (tab === 'faculty')    loadFaculty();
      if (tab === 'results')    loadResults();
    }
  }

  // ── 학원소개 탭 ──
  async function initAboutTab() {
    createQuill('quill-about-greeting', '인사말을 입력하세요.');
    createQuill('quill-about-history', '학원 연혁을 입력하세요.');
    createQuill('quill-about-features', '학원 특징을 입력하세요.');
    await Promise.all([
      loadPageContent('about_greeting', 'quill-about-greeting'),
      loadPageContent('about_history', 'quill-about-history'),
      loadPageContent('about_features', 'quill-about-features'),
    ]);
  }

  function switchAboutSub(sub: string) {
    ABOUT_SUBS.forEach(s => {
      document.getElementById(`about-sub-${s}`)?.classList.toggle('hidden', s !== sub);
    });
    document.querySelectorAll<HTMLButtonElement>('.about-sub').forEach(b => {
      const active = b.dataset.aboutSub === sub;
      b.classList.toggle('bg-brand', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('text-gray-500', !active);
    });
  }

  // ── 커리큘럼 탭 ──
  async function initCurriculumTab() {
    createQuill('quill-cur-elementary', '초등 커리큘럼을 입력하세요.');
    createQuill('quill-cur-middle', '중등 커리큘럼을 입력하세요.');
    createQuill('quill-cur-high', '고등 커리큘럼을 입력하세요.');
    await Promise.all([
      loadPageContent('curriculum_elementary', 'quill-cur-elementary'),
      loadPageContent('curriculum_middle', 'quill-cur-middle'),
      loadPageContent('curriculum_high', 'quill-cur-high'),
    ]);
  }

  function switchCurSub(sub: string) {
    CUR_SUBS.forEach(s => {
      document.getElementById(`cur-sub-${s}`)?.classList.toggle('hidden', s !== sub);
    });
    document.querySelectorAll<HTMLButtonElement>('.cur-sub').forEach(b => {
      const active = b.dataset.curSub === sub;
      b.classList.toggle('bg-brand', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('text-gray-500', !active);
    });
  }

  // ── 강사소개 ──
  let facultyEditId: number | null = null;

  function resetFacultyForm() {
    facultyEditId = null;
    (document.getElementById('faculty-name-input') as HTMLInputElement).value = '';
    (document.getElementById('faculty-motto-input') as HTMLInputElement).value = '';
    (document.getElementById('faculty-role-input') as HTMLInputElement).value = '';
    (document.getElementById('faculty-subject-input') as HTMLSelectElement).value = '수학';
    (document.getElementById('faculty-image-input') as HTMLInputElement).value = '';
    document.querySelectorAll<HTMLInputElement>('.faculty-div-check').forEach(cb => cb.checked = false);
    const preview = document.getElementById('faculty-image-preview') as HTMLImageElement;
    preview.src = '';
    preview.classList.add('hidden');
    document.getElementById('faculty-form-title')!.textContent = '강사 추가';
    document.getElementById('submit-faculty-btn')!.textContent = '추가';
    document.getElementById('cancel-faculty-btn')!.classList.add('hidden');
  }

  // ── 메인페이지(히어로) 관리 ──
  let heroEditId: string | null = null;

  function resetHeroForm() {
    heroEditId = null;
    (document.getElementById('hero-edit-id') as HTMLInputElement).value = '';
    (document.getElementById('hero-eyebrow-input') as HTMLInputElement).value = '';
    (document.getElementById('hero-title-input') as HTMLInputElement).value = '';
    (document.getElementById('hero-subtitle-input') as HTMLInputElement).value = '';
    (document.getElementById('hero-cta-text-input') as HTMLInputElement).value = '';
    (document.getElementById('hero-cta-link-input') as HTMLInputElement).value = '';
    (document.getElementById('hero-sort-input') as HTMLInputElement).value = '0';
    (document.getElementById('hero-active-input') as HTMLInputElement).checked = true;
    (document.getElementById('hero-image-input') as HTMLInputElement).value = '';
    const preview = document.getElementById('hero-image-preview') as HTMLImageElement;
    preview.src = ''; preview.classList.add('hidden');
    document.getElementById('hero-form-title')!.textContent = '슬라이드 추가';
    document.getElementById('submit-hero-btn')!.textContent = '추가';
    document.getElementById('cancel-hero-btn')!.classList.add('hidden');
  }

  async function loadHeroSlides() {
    const container = document.getElementById('hero-list')!;
    const { data, error } = await supabase.from('hero_slides').select('*').order('sort_order').order('created_at');
    if (error) {
      container.innerHTML = `<p class="text-sm text-red-400 py-4 text-center">불러오기 오류: ${escHtml(error.message)}</p>`;
      return;
    }
    if (!data || data.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400 py-4 text-center">등록된 슬라이드가 없습니다. 위에서 추가하세요. (없으면 기본 배너가 표시됩니다)</p>';
      return;
    }
    container.innerHTML = data.map(h => `
      <div class="py-3 flex items-center gap-4">
        <img src="${escHtml(h.image_url || '')}" alt="배너" class="w-24 h-14 rounded-lg object-cover bg-gray-100 flex-shrink-0" onerror="this.style.opacity='0.2'" />
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-900 truncate">
            ${escHtml(h.title || '대치프라임')}
            ${h.is_active ? '' : '<span class="ml-1 text-xs text-gray-400 font-normal">(숨김)</span>'}
          </p>
          <p class="text-xs text-gray-400 truncate">${escHtml(h.subtitle || '')} · 버튼: ${escHtml(h.cta_text || '')} → ${escHtml(h.cta_link || '')} · 순서 ${h.sort_order}</p>
        </div>
        <div class="flex gap-3 flex-shrink-0">
          <button data-id="${h.id}"
            data-image="${escAttr(h.image_url ?? '')}" data-eyebrow="${escAttr(h.eyebrow ?? '')}"
            data-title="${escAttr(h.title ?? '')}" data-subtitle="${escAttr(h.subtitle ?? '')}"
            data-ctatext="${escAttr(h.cta_text ?? '')}" data-ctalink="${escAttr(h.cta_link ?? '')}"
            data-sort="${h.sort_order}" data-active="${h.is_active ? '1' : '0'}"
            class="edit-hero-btn text-xs text-blue-400 hover:text-blue-600 transition-colors">수정</button>
          <button data-id="${h.id}" class="del-hero-btn text-xs text-red-400 hover:text-red-600 transition-colors">삭제</button>
        </div>
      </div>
    `).join('');

    container.querySelectorAll<HTMLButtonElement>('.edit-hero-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        heroEditId = btn.dataset.id!;
        (document.getElementById('hero-eyebrow-input') as HTMLInputElement).value = btn.dataset.eyebrow ?? '';
        (document.getElementById('hero-title-input') as HTMLInputElement).value = btn.dataset.title ?? '';
        (document.getElementById('hero-subtitle-input') as HTMLInputElement).value = btn.dataset.subtitle ?? '';
        (document.getElementById('hero-cta-text-input') as HTMLInputElement).value = btn.dataset.ctatext ?? '';
        (document.getElementById('hero-cta-link-input') as HTMLInputElement).value = btn.dataset.ctalink ?? '';
        (document.getElementById('hero-sort-input') as HTMLInputElement).value = btn.dataset.sort ?? '0';
        (document.getElementById('hero-active-input') as HTMLInputElement).checked = btn.dataset.active === '1';
        const preview = document.getElementById('hero-image-preview') as HTMLImageElement;
        if (btn.dataset.image) { preview.src = btn.dataset.image; preview.classList.remove('hidden'); }
        document.getElementById('hero-form-title')!.textContent = '슬라이드 수정';
        document.getElementById('submit-hero-btn')!.textContent = '수정 완료';
        document.getElementById('cancel-hero-btn')!.classList.remove('hidden');
        document.getElementById('hero-form-title')!.scrollIntoView({ behavior: 'smooth' });
      });
    });

    container.querySelectorAll<HTMLButtonElement>('.del-hero-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('이 슬라이드를 삭제할까요?')) return;
        await supabase.from('hero_slides').delete().eq('id', btn.dataset.id!);
        loadHeroSlides();
      });
    });
  }

  document.getElementById('hero-image-input')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const preview = document.getElementById('hero-image-preview') as HTMLImageElement;
      preview.src = ev.target?.result as string;
      preview.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  });

  document.getElementById('submit-hero-btn')?.addEventListener('click', async () => {
    const eyebrow  = (document.getElementById('hero-eyebrow-input') as HTMLInputElement).value.trim();
    const title    = (document.getElementById('hero-title-input') as HTMLInputElement).value.trim();
    const subtitle = (document.getElementById('hero-subtitle-input') as HTMLInputElement).value.trim();
    const ctaText  = (document.getElementById('hero-cta-text-input') as HTMLInputElement).value.trim();
    const ctaLink  = (document.getElementById('hero-cta-link-input') as HTMLInputElement).value.trim();
    const sortOrder = parseInt((document.getElementById('hero-sort-input') as HTMLInputElement).value, 10) || 0;
    const isActive = (document.getElementById('hero-active-input') as HTMLInputElement).checked;
    const fileInput = document.getElementById('hero-image-input') as HTMLInputElement;
    const file = fileInput.files?.[0];
    const msg = document.getElementById('hero-msg')!;

    if (!heroEditId && !file) {
      msg.textContent = '배너 이미지를 선택하세요.'; msg.classList.remove('hidden');
      setTimeout(() => msg.classList.add('hidden'), 3000);
      return;
    }

    const btn = document.getElementById('submit-hero-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '처리 중...';

    let image_url: string | undefined;
    if (file) {
      const ext = file.name.split('.').pop();
      const path = `hero-${Date.now()}.${ext}`;
      const { data: up, error: upErr } = await supabase.storage.from('hero-images').upload(path, file, { upsert: true });
      if (upErr) {
        msg.textContent = '이미지 업로드 실패: ' + upErr.message; msg.classList.remove('hidden');
        btn.disabled = false; btn.textContent = heroEditId ? '수정 완료' : '추가';
        return;
      }
      if (up) {
        const { data: urlData } = supabase.storage.from('hero-images').getPublicUrl(path);
        image_url = urlData.publicUrl;
      }
    }

    const payload: any = {
      eyebrow: eyebrow || null, title: title || null, subtitle: subtitle || null,
      cta_text: ctaText || null, cta_link: ctaLink || null,
      sort_order: sortOrder, is_active: isActive,
    };
    if (image_url) payload.image_url = image_url;

    let error;
    if (heroEditId) {
      ({ error } = await supabase.from('hero_slides').update(payload).eq('id', heroEditId));
    } else {
      ({ error } = await supabase.from('hero_slides').insert(payload));
    }

    btn.disabled = false;
    btn.textContent = heroEditId ? '수정 완료' : '추가';

    if (error) { msg.textContent = '오류: ' + error.message; }
    else { msg.textContent = heroEditId ? '수정되었습니다.' : '추가되었습니다.'; resetHeroForm(); loadHeroSlides(); }
    msg.classList.remove('hidden');
    setTimeout(() => msg.classList.add('hidden'), 3000);
  });

  document.getElementById('cancel-hero-btn')?.addEventListener('click', resetHeroForm);

  async function loadFaculty() {
    const container = document.getElementById('faculty-list')!;
    const { data, error } = await supabase.from('faculty').select('*').order('sort_order').order('id');
    if (error || !data || data.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400 py-4 text-center">강사 정보가 없습니다.</p>';
      return;
    }
    const colors: Record<string, string> = {
      '수학': 'text-blue-500', '영어': 'text-green-500',
      '과학': 'text-orange-500', '국어': 'text-brand', '탐독': 'text-purple-500',
    };
    container.innerHTML = data.map(f => `
      <div class="py-3 flex items-center gap-4">
        <img src="${escHtml(f.image_url || '')}" alt="${escHtml(f.name)}"
          class="w-12 h-12 rounded-full object-cover object-top bg-gray-100 flex-shrink-0"
          onerror="this.style.opacity='0.2'" />
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-900">
            <span class="${colors[f.subject] ?? 'text-gray-500'} mr-1">${escHtml(f.subject)}</span>
            ${escHtml(f.name)} 선생님
          </p>
          <p class="text-xs text-gray-400 truncate">
            ${Array.isArray(f.divisions) && f.divisions.length ? f.divisions.join(' · ') : '소속 없음'}
            ${f.role ? ' · ' + escHtml(f.role) : ''}
          </p>
        </div>
        <div class="flex gap-3 flex-shrink-0">
          <button data-id="${f.id}" data-name="${escAttr(f.name)}" data-subject="${escAttr(f.subject)}"
            data-motto="${escAttr(f.motto ?? '')}" data-image="${escAttr(f.image_url ?? '')}"
            data-divisions="${escAttr(JSON.stringify(f.divisions ?? []))}"
            data-role="${escAttr(f.role ?? '')}"
            class="edit-faculty-btn text-xs text-blue-400 hover:text-blue-600 transition-colors">수정</button>
          <button data-id="${f.id}" class="del-faculty-btn text-xs text-red-400 hover:text-red-600 transition-colors">삭제</button>
        </div>
      </div>
    `).join('');

    container.querySelectorAll<HTMLButtonElement>('.edit-faculty-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        facultyEditId = Number(btn.dataset.id);
        (document.getElementById('faculty-name-input') as HTMLInputElement).value = btn.dataset.name ?? '';
        (document.getElementById('faculty-motto-input') as HTMLInputElement).value = btn.dataset.motto ?? '';
        (document.getElementById('faculty-role-input') as HTMLInputElement).value = btn.dataset.role ?? '';
        (document.getElementById('faculty-subject-input') as HTMLSelectElement).value = btn.dataset.subject ?? '수학';
        const divs: string[] = JSON.parse(btn.dataset.divisions ?? '[]');
        document.querySelectorAll<HTMLInputElement>('.faculty-div-check').forEach(cb => {
          cb.checked = divs.includes(cb.value);
        });
        const preview = document.getElementById('faculty-image-preview') as HTMLImageElement;
        if (btn.dataset.image) { preview.src = btn.dataset.image; preview.classList.remove('hidden'); }
        document.getElementById('faculty-form-title')!.textContent = '강사 수정';
        document.getElementById('submit-faculty-btn')!.textContent = '수정 완료';
        document.getElementById('cancel-faculty-btn')!.classList.remove('hidden');
        document.getElementById('faculty-form-title')!.scrollIntoView({ behavior: 'smooth' });
      });
    });

    container.querySelectorAll<HTMLButtonElement>('.del-faculty-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('이 강사를 삭제할까요?')) return;
        await supabase.from('faculty').delete().eq('id', btn.dataset.id!);
        loadFaculty();
      });
    });
  }

  document.getElementById('faculty-image-input')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const preview = document.getElementById('faculty-image-preview') as HTMLImageElement;
      preview.src = ev.target?.result as string;
      preview.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  });

  document.getElementById('submit-faculty-btn')?.addEventListener('click', async () => {
    const name    = (document.getElementById('faculty-name-input') as HTMLInputElement).value.trim();
    const subject = (document.getElementById('faculty-subject-input') as HTMLSelectElement).value;
    const motto   = (document.getElementById('faculty-motto-input') as HTMLInputElement).value.trim();
    const role    = (document.getElementById('faculty-role-input') as HTMLInputElement).value.trim();
    const divisions = Array.from(document.querySelectorAll<HTMLInputElement>('.faculty-div-check:checked')).map(cb => cb.value);
    const fileInput = document.getElementById('faculty-image-input') as HTMLInputElement;
    const file    = fileInput.files?.[0];
    const msg     = document.getElementById('faculty-msg')!;

    if (!name) {
      msg.textContent = '이름을 입력하세요.'; msg.classList.remove('hidden'); return;
    }
    const btn = document.getElementById('submit-faculty-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '처리 중...';

    let image_url: string | undefined;
    if (file) {
      const ext = file.name.split('.').pop();
      const path = `${Date.now()}.${ext}`;
      const { data: up, error: upErr } = await supabase.storage.from('faculty-images').upload(path, file, { upsert: true });
      if (!upErr && up) {
        const { data: urlData } = supabase.storage.from('faculty-images').getPublicUrl(path);
        image_url = urlData.publicUrl;
      }
    }

    let error;
    if (facultyEditId) {
      const updateData: any = { name, subject, motto, role, divisions };
      if (image_url) updateData.image_url = image_url;
      ({ error } = await supabase.from('faculty').update(updateData).eq('id', facultyEditId));
    } else {
      ({ error } = await supabase.from('faculty').insert({ name, subject, motto, role, divisions, image_url: image_url ?? '' }));
    }

    btn.disabled = false;
    btn.textContent = facultyEditId ? '수정 완료' : '추가';

    if (error) { msg.textContent = '오류: ' + error.message; }
    else { msg.textContent = facultyEditId ? '수정되었습니다.' : '추가되었습니다.'; resetFacultyForm(); loadFaculty(); }
    msg.classList.remove('hidden');
    setTimeout(() => msg.classList.add('hidden'), 3000);
  });

  document.getElementById('cancel-faculty-btn')?.addEventListener('click', resetFacultyForm);

  // ── 명예의 전당 ──
  async function loadResults(yearFilter?: string) {
    const container = document.getElementById('result-list')!;
    let query = supabase.from('results').select('*').order('year', { ascending: false }).order('id', { ascending: false });
    if (yearFilter) query = query.eq('year', yearFilter);
    const { data, error } = await query.limit(300);

    if (error || !data || data.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400 py-4 text-center">데이터가 없습니다.</p>';
      return;
    }

    // 연도 필터 옵션 업데이트
    const years = [...new Set(data.map((r: any) => r.year))].sort((a: any, b: any) => b.localeCompare(a));
    const filterEl = document.getElementById('result-year-filter') as HTMLSelectElement;
    const cur = filterEl.value;
    filterEl.innerHTML = '<option value="">전체 연도</option>' +
      years.map((y: any) => `<option value="${y}" ${y === cur ? 'selected' : ''}>${y}</option>`).join('');

    container.innerHTML = data.map((r: any) => `
      <div class="py-3 flex items-center gap-3">
        <div class="flex-1 min-w-0">
          <p class="text-sm text-gray-900">
            <span class="font-medium">${escHtml(r.year)} ${escHtml(r.category)}</span>
            · ${escHtml(r.name)} · ${escHtml(r.university)}${r.dept ? ' ' + escHtml(r.dept) : ''}
          </p>
          ${r.school ? `<p class="text-xs text-gray-400">${escHtml(r.school)}</p>` : ''}
        </div>
        <button data-id="${r.id}" class="del-result-btn text-xs text-red-400 hover:text-red-600 flex-shrink-0 transition-colors">삭제</button>
      </div>
    `).join('');

    container.querySelectorAll<HTMLButtonElement>('.del-result-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('삭제할까요?')) return;
        await supabase.from('results').delete().eq('id', btn.dataset.id!);
        loadResults((document.getElementById('result-year-filter') as HTMLSelectElement).value || undefined);
      });
    });
  }

  document.getElementById('submit-result-btn')?.addEventListener('click', async () => {
    const year       = (document.getElementById('result-year-input') as HTMLInputElement).value.trim();
    const category   = (document.getElementById('result-category-input') as HTMLSelectElement).value;
    const school     = (document.getElementById('result-school-input') as HTMLInputElement).value.trim();
    const name       = (document.getElementById('result-name-input') as HTMLInputElement).value.trim();
    const university = (document.getElementById('result-university-input') as HTMLInputElement).value.trim();
    const dept       = (document.getElementById('result-dept-input') as HTMLInputElement).value.trim();
    const msg        = document.getElementById('result-msg')!;

    if (!year || !name || !university) {
      msg.textContent = '연도, 이름, 대학(고교)은 필수입니다.'; msg.classList.remove('hidden'); return;
    }
    const btn = document.getElementById('submit-result-btn') as HTMLButtonElement;
    btn.disabled = true;
    const { error } = await supabase.from('results').insert({ year, category, school, name, university, dept: dept || null });
    btn.disabled = false;

    if (error) { msg.textContent = '오류: ' + error.message; }
    else {
      msg.textContent = '추가되었습니다.';
      ['result-name-input','result-university-input','result-dept-input','result-school-input'].forEach(id => {
        (document.getElementById(id) as HTMLInputElement).value = '';
      });
      loadResults((document.getElementById('result-year-filter') as HTMLSelectElement).value || undefined);
    }
    msg.classList.remove('hidden');
    setTimeout(() => msg.classList.add('hidden'), 3000);
  });

  document.getElementById('result-year-filter')?.addEventListener('change', (e) => {
    loadResults((e.target as HTMLSelectElement).value || undefined);
  });

  // ── 공지사항 ──
  let editingId: string | null = null;

  function resetNoticeForm() {
    editingId = null;
    (document.getElementById('notice-title-input') as HTMLInputElement).value = '';
    quills['quill-notices']?.setContents([]);
    document.getElementById('form-title')!.textContent = '새 공지 작성';
    document.getElementById('submit-notice-btn')!.textContent = '등록';
    document.getElementById('cancel-edit-btn')!.classList.add('hidden');
  }

  function startEdit(id: string, title: string, content: string) {
    editingId = id;
    (document.getElementById('notice-title-input') as HTMLInputElement).value = title;
    const q = quills['quill-notices'];
    if (q) { q.setContents(q.clipboard.convert({ html: content })); }
    document.getElementById('form-title')!.textContent = '공지 수정';
    document.getElementById('submit-notice-btn')!.textContent = '수정 완료';
    document.getElementById('cancel-edit-btn')!.classList.remove('hidden');
    document.getElementById('notice-title-input')!.scrollIntoView({ behavior: 'smooth' });
  }

  document.getElementById('cancel-edit-btn')?.addEventListener('click', resetNoticeForm);

  document.getElementById('submit-notice-btn')?.addEventListener('click', async () => {
    const title   = (document.getElementById('notice-title-input') as HTMLInputElement).value.trim();
    const q       = quills['quill-notices'];
    const content = q ? q.root.innerHTML : '';
    const isEmpty = !q || q.getText().trim() === '';
    const msg     = document.getElementById('notice-msg')!;

    if (!title || isEmpty) {
      msg.textContent = '제목과 내용을 입력하세요.'; msg.classList.remove('hidden'); return;
    }
    const btn = document.getElementById('submit-notice-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '처리 중...';

    let error;
    if (editingId) {
      ({ error } = await supabase.from('notices').update({ title, content }).eq('id', editingId));
    } else {
      ({ error } = await supabase.from('notices').insert({ title, content, views: 0 }));
    }
    btn.disabled = false;
    btn.textContent = editingId ? '수정 완료' : '등록';

    if (error) { msg.textContent = '오류: ' + error.message; }
    else { msg.textContent = editingId ? '수정되었습니다.' : '등록되었습니다.'; resetNoticeForm(); loadNotices(); }
    msg.classList.remove('hidden');
    setTimeout(() => msg.classList.add('hidden'), 3000);
  });

  async function loadNotices() {
    const container = document.getElementById('notice-list')!;
    const { data, error } = await supabase.from('notices').select('*').order('created_at', { ascending: false }).limit(50);
    if (error || !data || data.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400 py-4 text-center">공지사항이 없습니다.</p>'; return;
    }
    container.innerHTML = data.map(n => `
      <div class="py-4 flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900 truncate">${escHtml(n.title)}</p>
          <p class="text-xs text-gray-400 mt-1">${new Date(n.created_at).toLocaleDateString('ko-KR')} · 조회 ${(n.views ?? 0).toLocaleString()}</p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0">
          <button data-id="${n.id}" data-title="${escAttr(n.title)}" data-content="${escAttr(n.content ?? '')}"
            class="edit-notice-btn text-xs text-blue-400 hover:text-blue-600 transition-colors">수정</button>
          <button data-id="${n.id}" class="del-notice-btn text-xs text-red-400 hover:text-red-600 transition-colors">삭제</button>
        </div>
      </div>
    `).join('');

    container.querySelectorAll<HTMLButtonElement>('.edit-notice-btn').forEach(btn => {
      btn.addEventListener('click', () => startEdit(btn.dataset.id!, btn.dataset.title!, btn.dataset.content!));
    });
    container.querySelectorAll<HTMLButtonElement>('.del-notice-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('이 공지를 삭제할까요?')) return;
        await supabase.from('notices').delete().eq('id', btn.dataset.id!);
        loadNotices();
      });
    });
  }

  // ── 상담 신청 ──
  const HIGH_VALUE = ['탐독', '입시컨설팅'];
  const STATUS_LABEL: Record<string, string> = {
    new: '신규', contacted: '연락완료', consulting: '상담중', enrolled: '등록완료', closed: '종결',
  };
  const STATUS_STYLE: Record<string, string> = {
    new: 'bg-red-50 text-red-500', contacted: 'bg-amber-50 text-amber-600',
    consulting: 'bg-blue-50 text-blue-600', enrolled: 'bg-green-50 text-green-600',
    closed: 'bg-gray-100 text-gray-400',
  };

  let allInquiries: any[] = [];

  function asArray(v: any): string[] {
    if (Array.isArray(v)) return v;
    if (typeof v === 'string' && v) return [v];
    return [];
  }

  function filteredInquiries() {
    const status   = (document.getElementById('inq-filter-status') as HTMLSelectElement).value;
    const branch   = (document.getElementById('inq-filter-branch') as HTMLSelectElement).value;
    const grade    = (document.getElementById('inq-filter-grade') as HTMLSelectElement).value;
    const subject  = (document.getElementById('inq-filter-subject') as HTMLSelectElement).value;
    const highOnly = (document.getElementById('inq-filter-highvalue') as HTMLInputElement).checked;
    const search   = (document.getElementById('inq-filter-search') as HTMLInputElement).value.trim().toLowerCase();

    return allInquiries.filter(q => {
      const subjects = asArray(q.subjects);
      const branches = asArray(q.branch);
      if (status && (q.status ?? 'new') !== status) return false;
      if (branch && !branches.includes(branch)) return false;
      if (grade && q.grade !== grade) return false;
      if (subject && !subjects.includes(subject)) return false;
      if (highOnly && !subjects.some(s => HIGH_VALUE.includes(s))) return false;
      if (search) {
        const hay = [q.student_name, q.parent_name, q.student_phone, q.parent_phone, q.school, q.school_name]
          .filter(Boolean).join(' ').toLowerCase();
        if (!hay.includes(search)) return false;
      }
      return true;
    });
  }

  function renderInquiries() {
    const container = document.getElementById('inquiry-list')!;
    const rows = filteredInquiries();
    const countEl = document.getElementById('inq-count')!;
    countEl.textContent = `총 ${rows.length}건 (전체 ${allInquiries.length}건)`;

    if (rows.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400 py-8 text-center">조건에 맞는 신청이 없습니다.</p>';
      return;
    }

    container.innerHTML = rows.map(q => {
      const subjects = asArray(q.subjects);
      const branches = asArray(q.branch);
      const status = q.status ?? 'new';
      const isHigh = subjects.some(s => HIGH_VALUE.includes(s));

      const subjectTags = subjects.map(s => {
        const hi = HIGH_VALUE.includes(s);
        return `<span class="inline-block text-xs px-2 py-0.5 rounded-full ${hi ? 'bg-purple-100 text-purple-700 font-semibold' : 'bg-gray-100 text-gray-500'}">${hi ? '⭐ ' : ''}${escHtml(s)}</span>`;
      }).join(' ');

      const statusOptions = Object.keys(STATUS_LABEL).map(k =>
        `<option value="${k}" ${k === status ? 'selected' : ''}>${STATUS_LABEL[k]}</option>`).join('');

      return `
      <div class="py-4 ${isHigh ? 'bg-purple-50/40 -mx-6 px-6 border-l-2 border-purple-300' : ''}">
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-xs px-2 py-0.5 rounded-full font-medium ${STATUS_STYLE[status]}">${STATUS_LABEL[status]}</span>
            <p class="text-sm font-semibold text-gray-900 truncate">
              ${escHtml(q.student_name ?? '')} ${q.grade ? `<span class="text-gray-400 font-normal">· ${escHtml(q.grade)}</span>` : ''}
            </p>
          </div>
          <p class="text-xs text-gray-400 flex-shrink-0">${new Date(q.created_at).toLocaleDateString('ko-KR')}</p>
        </div>

        <div class="text-xs text-gray-500 space-y-0.5 mb-2">
          <p>📱 학생 ${escHtml(q.student_phone ?? '-')}${q.parent_name ? ` · 학부모 ${escHtml(q.parent_name)} ${escHtml(q.parent_phone ?? '')}` : ''}</p>
          ${(q.school ?? q.school_name) ? `<p>🏫 ${escHtml(q.school ?? q.school_name)}${q.track ? ` · ${escHtml(q.track)}` : ''}</p>` : ''}
          ${branches.length ? `<p>📍 ${escHtml(branches.join(', '))}</p>` : ''}
        </div>

        ${subjects.length ? `<div class="flex flex-wrap gap-1 mb-2">${subjectTags}</div>` : ''}
        ${q.other_detail ? `<p class="text-sm text-gray-700 bg-amber-50 border border-amber-100 rounded-lg px-3 py-2 mb-2 whitespace-pre-wrap"><span class="text-xs font-semibold text-amber-600">기타 문의</span><br/>${escHtml(q.other_detail)}</p>` : ''}

        <div class="flex flex-wrap items-center gap-2 mt-2">
          <select data-id="${q.id}" class="inq-status-select border border-gray-200 rounded-lg px-2 py-1 text-xs focus:outline-none focus:border-brand">${statusOptions}</select>
          <input data-id="${q.id}" type="text" value="${escAttr(q.assigned_to ?? '')}" placeholder="담당자"
            class="inq-assigned-input border border-gray-200 rounded-lg px-2 py-1 text-xs w-24 focus:outline-none focus:border-brand" />
          <input data-id="${q.id}" type="text" value="${escAttr(q.admin_note ?? '')}" placeholder="내부 메모"
            class="inq-note-input flex-1 min-w-[120px] border border-gray-200 rounded-lg px-2 py-1 text-xs focus:outline-none focus:border-brand" />
          <button data-id="${q.id}" class="inq-del-btn text-xs text-red-400 hover:text-red-600 transition-colors flex-shrink-0">삭제</button>
        </div>
      </div>`;
    }).join('');

    // 상태 변경 (즉시 반영)
    container.querySelectorAll<HTMLSelectElement>('.inq-status-select').forEach(sel => {
      sel.addEventListener('change', async () => {
        const patch: any = { status: sel.value };
        if (sel.value === 'contacted') patch.contacted_at = new Date().toISOString();
        await supabase.from('inquiries').update(patch).eq('id', sel.dataset.id!);
        const row = allInquiries.find(x => x.id == sel.dataset.id);
        if (row) row.status = sel.value;
        renderInquiries();
      });
    });

    // 담당자 / 메모 (blur 시 저장)
    container.querySelectorAll<HTMLInputElement>('.inq-assigned-input').forEach(inp => {
      inp.addEventListener('blur', async () => {
        await supabase.from('inquiries').update({ assigned_to: inp.value.trim() || null }).eq('id', inp.dataset.id!);
        const row = allInquiries.find(x => x.id == inp.dataset.id);
        if (row) row.assigned_to = inp.value.trim();
      });
    });
    container.querySelectorAll<HTMLInputElement>('.inq-note-input').forEach(inp => {
      inp.addEventListener('blur', async () => {
        await supabase.from('inquiries').update({ admin_note: inp.value.trim() || null }).eq('id', inp.dataset.id!);
        const row = allInquiries.find(x => x.id == inp.dataset.id);
        if (row) row.admin_note = inp.value.trim();
      });
    });

    // 삭제
    container.querySelectorAll<HTMLButtonElement>('.inq-del-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('이 상담 신청을 삭제할까요?')) return;
        await supabase.from('inquiries').delete().eq('id', btn.dataset.id!);
        allInquiries = allInquiries.filter(x => x.id != btn.dataset.id);
        renderInquiries();
      });
    });
  }

  async function loadInquiries() {
    const { data, error } = await supabase.from('inquiries').select('*').order('created_at', { ascending: false }).limit(300);
    if (error) {
      document.getElementById('inquiry-list')!.innerHTML = `<p class="text-sm text-red-400 py-4 text-center">불러오기 오류: ${escHtml(error.message)}</p>`;
      return;
    }
    allInquiries = data ?? [];
    renderInquiries();
  }

  // ── 로그인/로그아웃 ──
  function showPanel() {
    document.getElementById('login-screen')!.classList.add('hidden');
    document.getElementById('admin-panel')!.classList.remove('hidden');
    tabInited.add('notices');
    tabInited.add('inquiries');
    loadNotices();
    loadInquiries();
  }

  function showLogin() {
    document.getElementById('login-screen')!.classList.remove('hidden');
    document.getElementById('admin-panel')!.classList.add('hidden');
  }

  document.getElementById('login-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('login-btn') as HTMLButtonElement;
    const pw  = (document.getElementById('admin-pw') as HTMLInputElement).value;
    btn.disabled = true; btn.textContent = '확인 중...';
    const { data, error } = await supabase.rpc('verify_admin_password', { pw });
    btn.disabled = false; btn.textContent = '로그인';
    if (!error && data === true) {
      sessionStorage.setItem(SESSION_KEY, 'ok');
      document.getElementById('login-error')!.classList.add('hidden');
      showPanel();
    } else {
      document.getElementById('login-error')!.classList.remove('hidden');
    }
  });

  document.getElementById('admin-pw')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') (document.getElementById('login-btn') as HTMLButtonElement).click();
  });

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    sessionStorage.removeItem(SESSION_KEY); showLogin();
  });

  // ── 상담 신청 필터 이벤트 ──
  ['inq-filter-status', 'inq-filter-branch', 'inq-filter-grade', 'inq-filter-subject'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', renderInquiries);
  });
  document.getElementById('inq-filter-highvalue')?.addEventListener('change', renderInquiries);
  document.getElementById('inq-filter-search')?.addEventListener('input', renderInquiries);
  document.getElementById('inq-reset')?.addEventListener('click', () => {
    (document.getElementById('inq-filter-status') as HTMLSelectElement).value = '';
    (document.getElementById('inq-filter-branch') as HTMLSelectElement).value = '';
    (document.getElementById('inq-filter-grade') as HTMLSelectElement).value = '';
    (document.getElementById('inq-filter-subject') as HTMLSelectElement).value = '';
    (document.getElementById('inq-filter-highvalue') as HTMLInputElement).checked = false;
    (document.getElementById('inq-filter-search') as HTMLInputElement).value = '';
    renderInquiries();
  });

  // ── 신청 목록 다운로드 ──
  function openDownloadModal() {
    const list = document.getElementById('download-source-list');
    if (list) {
      list.innerHTML = DOWNLOAD_SOURCES.map(s => `
        <button data-dl="${s.key}" class="dl-source w-full flex items-center justify-between px-4 py-3 rounded-lg border border-gray-200 hover:border-brand hover:bg-brand-light text-left transition-colors">
          <span class="text-sm font-semibold text-gray-800">${s.label}</span>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/></svg>
        </button>`).join('');
    }
    const modal = document.getElementById('download-modal');
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeDownloadModal() {
    const modal = document.getElementById('download-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  async function downloadSource(key: string, btn?: HTMLButtonElement) {
    const source = DOWNLOAD_SOURCES.find(s => s.key === key);
    if (!source) return;
    const XLSX = (window as any).XLSX;
    if (!XLSX) { alert('엑셀 라이브러리를 불러오지 못했습니다. 새로고침 후 다시 시도해주세요.'); return; }

    const orig = btn?.innerHTML;
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="text-sm text-gray-400">불러오는 중...</span>'; }

    const { data, error } = await supabase
      .from(source.table)
      .select('*')
      .order(source.order, { ascending: false });

    if (btn && orig) { btn.disabled = false; btn.innerHTML = orig; }

    if (error) { alert('데이터를 불러오지 못했습니다: ' + error.message); return; }
    if (!data || data.length === 0) { alert(`'${source.label}' 신청 내역이 아직 없습니다.`); return; }

    const rows = data.map(r => {
      const o: Record<string, any> = {};
      source.columns.forEach(([header, get]) => { o[header] = get(r) ?? ''; });
      return o;
    });

    const ws = XLSX.utils.json_to_sheet(rows, { header: source.columns.map(c => c[0]) });
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, source.label.slice(0, 28));
    const today = new Date().toISOString().slice(0, 10);
    XLSX.writeFile(wb, `${source.label}_${today}.xlsx`);
  }

  document.getElementById('download-btn')?.addEventListener('click', openDownloadModal);
  document.getElementById('download-close')?.addEventListener('click', closeDownloadModal);
  document.getElementById('download-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('download-modal')) closeDownloadModal();
  });
  document.getElementById('download-source-list')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.dl-source');
    if (btn) downloadSource(btn.dataset.dl!, btn);
  });

  // ── 탭 이벤트 ──
  document.querySelectorAll<HTMLButtonElement>('.admin-tab').forEach(tab => {
    tab.addEventListener('click', () => switchMainTab(tab.dataset.tab!));
  });

  document.querySelectorAll<HTMLButtonElement>('.about-sub').forEach(btn => {
    btn.addEventListener('click', () => switchAboutSub(btn.dataset.aboutSub!));
  });

  document.querySelectorAll<HTMLButtonElement>('.cur-sub').forEach(btn => {
    btn.addEventListener('click', () => switchCurSub(btn.dataset.curSub!));
  });

  // save-content-btn 이벤트 (이벤트 위임)
  document.querySelector('.max-w-4xl')?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.save-content-btn');
    if (!btn) return;
    const key = btn.dataset.key!;
    const qid = btn.dataset.qid!;
    const orig = btn.textContent;
    btn.disabled = true; btn.textContent = '저장 중...';
    await savePageContent(key, qid);
    btn.disabled = false; btn.textContent = orig ?? '저장';
  });

  // ── 초기화 ──
  document.addEventListener('astro:page-load', async () => {
    if (!document.getElementById('login-screen')) return;
    await loadQuillLib();
    createQuill('quill-notices', '내용을 입력하세요. 이미지는 툴바의 🖼 버튼으로 삽입하세요.');
    if (isLoggedIn()) showPanel();
    else showLogin();
  });
</script>
