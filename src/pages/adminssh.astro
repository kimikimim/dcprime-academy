  document.getElementById('cancel-space-btn')?.addEventListener('click', resetSpaceForm);

  document.getElementById('submit-space-btn')?.addEventListener('click', async () => {
    const campus  = (document.getElementById('space-campus-input') as HTMLSelectElement).value;
    const caption = (document.getElementById('space-caption-input') as HTMLInputElement).value.trim();
    const sortOrder = parseInt((document.getElementById('space-sort-input') as HTMLInputElement).value, 10) || 0;
    const isActive = (document.getElementById('space-active-input') as HTMLInputElement).checked;
    const fileInput = document.getElementById('space-image-input') as HTMLInputElement;
    const file = fileInput.files?.[0];
    const msg = document.getElementById('space-msg')!;

    if (!spaceEditId && !file) {
      msg.textContent = '사진을 선택하세요.'; msg.classList.remove('hidden');
      setTimeout(() => msg.classList.add('hidden'), 3000);
      return;
    }

    const btn = document.getElementById('submit-space-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '처리 중...';

    let image_url: string | undefined;
    if (file) {
      const ext = file.name.split('.').pop();
      const path = `space-${Date.now()}.${ext}`;
      const { data: up, error: upErr } = await supabase.storage.from('space-images').upload(path, file, { upsert: true });
      if (upErr) {
        msg.textContent = '이미지 업로드 실패: ' + upErr.message; msg.classList.remove('hidden');
        btn.disabled = false; btn.textContent = spaceEditId ? '수정 완료' : '추가';
        return;
      }
      if (up) {
        const { data: urlData } = supabase.storage.from('space-images').getPublicUrl(path);
        image_url = urlData.publicUrl;
      }
    }

    const payload: any = { campus, caption: caption || null, sort_order: sortOrder, is_active: isActive };
    if (image_url) payload.image_url = image_url;

    let error;
    if (spaceEditId) {
      ({ error } = await supabase.from('space_photos').update(payload).eq('id', spaceEditId));
    } else {
      ({ error } = await supabase.from('space_photos').insert(payload));
    }

    btn.disabled = false;
    btn.textContent = spaceEditId ? '수정 완료' : '추가';

    if (error) { msg.textContent = '오류: ' + error.message; }
    else {
      msg.textContent = spaceEditId ? '수정되었습니다.' : '추가되었습니다.';
      // 목록 필터를 방금 저장한 캠퍼스로 맞춰 보여줌
      (document.getElementById('space-list-filter') as HTMLSelectElement).value = campus;
      resetSpaceForm();
      loadSpacePhotos(campus);
    }
    msg.classList.remove('hidden');
    setTimeout(() => msg.classList.add('hidden'), 3000);
  });

