    const subject    = (document.getElementById('report-subject-input') as HTMLSelectElement).value;
    const exam_date  = (document.getElementById('report-date-input') as HTMLInputElement).value.trim();
    const total      = (document.getElementById('report-total-input') as HTMLInputElement).value.trim();
    const difficulty_level = (document.getElementById('report-difficulty-input') as HTMLInputElement).value.trim();
    const scope      = (document.getElementById('report-scope-input') as HTMLInputElement).value.trim();
    const overview   = (document.getElementById('report-overview-input') as HTMLTextAreaElement).value.trim();
    const sectionsRaw = (document.getElementById('report-sections-input') as HTMLTextAreaElement).value.trim();
    const parent_guide = (document.getElementById('report-parentguide-input') as HTMLTextAreaElement).value.trim();
    const msg = document.getElementById('report-msg')!;

    let sections: any = [];
    if (sectionsRaw) {
      try {
        sections = JSON.parse(sectionsRaw);
      } catch (e) {
        msg.textContent = '세부 섹션 JSON 형식이 올바르지 않습니다.';
        msg.classList.remove('hidden');
        setTimeout(() => msg.classList.add('hidden'), 4000);
        return;
      }
    }

    const btn = document.getElementById('submit-report-btn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = '처리 중...';

    const payload = { grade, subject, exam_date, total, difficulty_level, scope, overview, sections, parent_guide };
    let error;
    if (reportEditId) {
      ({ error } = await supabase.from('exam_reports').update(payload).eq('id', reportEditId));
    } else {
      ({ error } = await supabase.from('exam_reports').upsert(payload, { onConflict: 'grade,subject' }));
    }

    btn.disabled = false;
    btn.textContent = reportEditId ? '수정 완료' : '추가';

    if (error) { msg.textContent = '오류: ' + error.message; }
    else { msg.textContent = reportEditId ? '수정되었습니다.' : '추가되었습니다.'; resetReportForm(); loadReportsAdmin(); }
    msg.classList.remove('hidden');
    setTimeout(() => msg.classList.add('hidden'), 3000);
  });

