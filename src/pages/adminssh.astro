---
import Layout from '../components/layout/Layout.astro';
---

<Layout title="관리자 - 대치프라임" description="">
  <div class="min-h-screen bg-gray-100">

    <!-- 로그인 화면 -->
    <div id="login-screen" class="flex items-center justify-center min-h-screen">
      <div class="bg-white rounded-2xl shadow-lg p-10 w-full max-w-sm">
        <h1 class="text-xl font-bold text-gray-900 mb-6 text-center">관리자 로그인</h1>
        <input id="admin-pw" type="password" placeholder="비밀번호" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm mb-3 focus:outline-none focus:border-brand" />
        <p id="login-error" class="text-red-500 text-xs mb-3 hidden">비밀번호가 틀렸습니다.</p>
        <button id="login-btn" class="w-full bg-brand text-white rounded-lg py-3 text-sm font-semibold hover:opacity-90 transition-opacity">로그인</button>
      </div>
    </div>

    <!-- 관리자 패널 -->
    <div id="admin-panel" class="hidden">
      <div class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
        <h1 class="text-lg font-bold text-gray-900">대치프라임 관리자</h1>
        <button id="logout-btn" class="text-sm text-gray-500 hover:text-gray-900 transition-colors">로그아웃</button>
      </div>

      <!-- 메인 탭 -->
      <div class="bg-white border-b border-gray-200 px-6">
        <div class="flex gap-6 overflow-x-auto scrollbar-hide items-center">
          <button id="download-btn" class="py-3 text-sm font-semibold text-brand whitespace-nowrap flex items-center gap-1.5 hover:opacity-80 transition-opacity">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/></svg>
            신청 목록 다운받기
          </button>
          <span class="w-px h-4 bg-gray-200 flex-shrink-0"></span>
          <button data-tab="hero"       class="admin-tab py-3 text-sm font-medium border-b-2 border-transparent text-gray-400 hover:text-gray-700 whitespace-nowrap">메인페이지 관리</button>
          <button data-tab="notices"    class="admin-tab py-3 text-sm font-medium border-b-2 border-brand text-brand whitespace-nowrap">공지사항 관리</button>
          <button data-tab="inquiries"  class="admin-tab py-3 text-sm font-medium border-b-2 border-transparent text-gray-400 hover:text-gray-700 whitespace-nowrap">상담 신청 목록</button>
          <button data-tab="about"      class="admin-tab py-3 text-sm font-medium border-b-2 border-transparent text-gray-400 hover:text-gray-700 whitespace-nowrap">학원소개</button>
          <button data-tab="curriculum" class="admin-tab py-3 text-sm font-medium border-b-2 border-transparent text-gray-400 hover:text-gray-700 whitespace-nowrap">커리큘럼</button>
          <button data-tab="faculty"    class="admin-tab py-3 text-sm font-medium border-b-2 border-transparent text-gray-400 hover:text-gray-700 whitespace-nowrap">강사소개</button>
          <button data-tab="results"    class="admin-tab py-3 text-sm font-medium border-b-2 border-transparent text-gray-400 hover:text-gray-700 whitespace-nowrap">명예의 전당</button>
        </div>
      </div>

      <div class="max-w-4xl mx-auto px-4 py-8">

        <!-- ── 메인페이지(히어로) 관리 탭 ── -->
        <div id="panel-hero" class="hidden">
          <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
            <h2 id="hero-form-title" class="text-base font-bold text-gray-900 mb-1">슬라이드 추가</h2>
            <p class="text-xs text-gray-400 mb-4">메인 화면 상단 배너입니다. 순서가 작을수록 먼저 나오고, 끄면(비활성) 화면에서 숨겨집니다.</p>
            <input type="hidden" id="hero-edit-id" />
            <div class="mb-3">
              <p class="text-xs text-gray-500 mb-2">배너 이미지 (가로로 넓은 사진 권장)</p>
              <input type="file" id="hero-image-input" accept="image/*" class="text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer" />
              <img id="hero-image-preview" class="hidden mt-2 w-full max-w-xs aspect-video object-cover rounded-lg border border-gray-200" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
              <div>
                <label class="block text-xs text-gray-500 mb-1">윗줄 (작은 글씨)</label>
                <input id="hero-eyebrow-input" type="text" placeholder="DC PRIME ACADEMY" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
              </div>
              <div>
                <label class="block text-xs text-gray-500 mb-1">제목 (큰 글씨)</label>
                <input id="hero-title-input" type="text" placeholder="대치프라임" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
              </div>
            </div>
            <div class="mb-3">
              <label class="block text-xs text-gray-500 mb-1">부제 (가운데 한 줄)</label>
              <input id="hero-subtitle-input" type="text" placeholder="교육과 미래를 디자인하는" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
              <div>
                <label class="block text-xs text-gray-500 mb-1">버튼 글씨</label>
                <input id="hero-cta-text-input" type="text" placeholder="상담 신청" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
              </div>
              <div>
                <label class="block text-xs text-gray-500 mb-1">버튼 링크 (예: /inquiry, /high3)</label>
                <input id="hero-cta-link-input" type="text" placeholder="/inquiry" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div>
                <label class="block text-xs text-gray-500 mb-1">순서 (숫자)</label>
                <input id="hero-sort-input" type="number" value="0" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
              </div>
              <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer mt-6">
                <input type="checkbox" id="hero-active-input" class="accent-brand" checked /> 활성 (화면에 표시)
              </label>
            </div>
            <div class="flex items-center gap-3">
              <button id="submit-hero-btn" class="bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90 transition-opacity">추가</button>
              <button id="cancel-hero-btn" class="hidden border border-gray-300 text-gray-600 rounded-lg px-6 py-2.5 text-sm font-semibold hover:bg-gray-50 transition-colors">취소</button>
              <p id="hero-msg" class="text-sm text-gray-500 hidden"></p>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm p-6">
            <h2 class="text-base font-bold text-gray-900 mb-4">슬라이드 목록</h2>
            <div id="hero-list" class="divide-y divide-gray-100">
              <p class="text-sm text-gray-400 py-4 text-center">불러오는 중...</p>
            </div>
          </div>
        </div>

        <!-- ── 공지사항 탭 ── -->
        <div id="panel-notices">
          <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
            <h2 id="form-title" class="text-base font-bold text-gray-900 mb-4">새 공지 작성</h2>
            <input id="notice-title-input" type="text" placeholder="제목" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm mb-3 focus:outline-none focus:border-brand" />
            <div class="quill-wrapper mb-3 border border-gray-300 rounded-lg overflow-hidden">
              <div id="quill-notices"></div>
            </div>
            <div class="flex items-center gap-3">
              <button id="submit-notice-btn" class="bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90 transition-opacity">등록</button>
              <button id="cancel-edit-btn" class="hidden border border-gray-300 text-gray-600 rounded-lg px-6 py-2.5 text-sm font-semibold hover:bg-gray-50 transition-colors">취소</button>
              <p id="notice-msg" class="text-sm text-gray-500 hidden"></p>
            </div>
          </div>
          <div class="bg-white rounded-2xl shadow-sm p-6">
            <h2 class="text-base font-bold text-gray-900 mb-4">공지 목록</h2>
            <div id="notice-list" class="divide-y divide-gray-100">
              <p class="text-sm text-gray-400 py-4 text-center">불러오는 중...</p>
            </div>
          </div>
        </div>

        <!-- ── 상담 신청 탭 ── -->
        <div id="panel-inquiries" class="hidden">

          <!-- 필터 바 -->
          <div class="bg-white rounded-2xl shadow-sm p-5 mb-4">
            <div class="flex flex-wrap items-center gap-2">
              <select id="inq-filter-status" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand">
                <option value="">상태 전체</option>
                <option value="new">신규</option>
                <option value="contacted">연락완료</option>
                <option value="consulting">상담중</option>
                <option value="enrolled">등록완료</option>
                <option value="closed">종결</option>
              </select>
              <select id="inq-filter-branch" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand">
                <option value="">분원 전체</option>
                <option value="능곡관">능곡관</option>
                <option value="장곡관">장곡관</option>
              </select>
              <select id="inq-filter-grade" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand">
                <option value="">학년 전체</option>
                <option>초4</option><option>초5</option><option>초6</option>
                <option>중1</option><option>중2</option><option>중3</option>
                <option>고1</option><option>고2</option><option>고3</option>
              </select>
              <select id="inq-filter-subject" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand">
                <option value="">과목 전체</option>
                <option>국어</option><option>영어</option><option>수학</option><option>과학</option>
                <option value="탐독">탐독 ⭐</option>
                <option value="입시컨설팅">입시컨설팅 ⭐</option>
                <option value="일반상담">일반상담</option>
                <option value="기타">기타</option>
              </select>
              <label class="flex items-center gap-1.5 text-sm text-gray-700 cursor-pointer ml-1">
                <input type="checkbox" id="inq-filter-highvalue" class="w-4 h-4 accent-brand" />
                <span class="font-medium text-purple-600">고가치만 ⭐</span>
              </label>
              <input id="inq-filter-search" type="text" placeholder="이름·전화·학교 검색"
                class="flex-1 min-w-[140px] border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand" />
            </div>
            <div class="flex items-center justify-between mt-3 text-xs text-gray-400">
              <span id="inq-count">—</span>
              <button id="inq-reset" class="text-gray-400 hover:text-gray-700 transition-colors">필터 초기화</button>
            </div>
          </div>

          <!-- 목록 -->
          <div class="bg-white rounded-2xl shadow-sm p-6">
            <div id="inquiry-list" class="divide-y divide-gray-100">
              <p class="text-sm text-gray-400 py-4 text-center">불러오는 중...</p>
            </div>
          </div>
        </div>

        <!-- ── 학원소개 탭 ── -->
        <div id="panel-about" class="hidden">
          <div class="flex gap-1 mb-6 bg-white rounded-xl shadow-sm p-1">
            <button data-about-sub="greeting" class="about-sub flex-1 py-2 rounded-lg text-sm font-medium bg-brand text-white transition-colors">인사말</button>
            <button data-about-sub="history"  class="about-sub flex-1 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition-colors">학원 연혁</button>
            <button data-about-sub="features" class="about-sub flex-1 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition-colors">학원 특징</button>
          </div>

          <div id="about-sub-greeting" class="bg-white rounded-2xl shadow-sm p-6">
            <div class="quill-wrapper mb-3 border border-gray-300 rounded-lg overflow-hidden">
              <div id="quill-about-greeting"></div>
            </div>
            <div class="flex items-center gap-3">
              <button data-key="about_greeting" data-qid="quill-about-greeting" class="save-content-btn bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90">저장</button>
              <span id="msg-about_greeting" class="text-sm text-gray-500 hidden">저장되었습니다.</span>
            </div>
          </div>

          <div id="about-sub-history" class="hidden bg-white rounded-2xl shadow-sm p-6">
            <div class="quill-wrapper mb-3 border border-gray-300 rounded-lg overflow-hidden">
              <div id="quill-about-history"></div>
            </div>
            <div class="flex items-center gap-3">
              <button data-key="about_history" data-qid="quill-about-history" class="save-content-btn bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90">저장</button>
              <span id="msg-about_history" class="text-sm text-gray-500 hidden">저장되었습니다.</span>
            </div>
          </div>

          <div id="about-sub-features" class="hidden bg-white rounded-2xl shadow-sm p-6">
            <div class="quill-wrapper mb-3 border border-gray-300 rounded-lg overflow-hidden">
              <div id="quill-about-features"></div>
            </div>
            <div class="flex items-center gap-3">
              <button data-key="about_features" data-qid="quill-about-features" class="save-content-btn bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90">저장</button>
              <span id="msg-about_features" class="text-sm text-gray-500 hidden">저장되었습니다.</span>
            </div>
          </div>
        </div>

        <!-- ── 커리큘럼 탭 ── -->
        <div id="panel-curriculum" class="hidden">
          <div class="flex gap-1 mb-6 bg-white rounded-xl shadow-sm p-1">
            <button data-cur-sub="elementary" class="cur-sub flex-1 py-2 rounded-lg text-sm font-medium bg-brand text-white transition-colors">초등</button>
            <button data-cur-sub="middle"     class="cur-sub flex-1 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition-colors">중등</button>
            <button data-cur-sub="high"       class="cur-sub flex-1 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition-colors">고등</button>
          </div>

          <div id="cur-sub-elementary" class="bg-white rounded-2xl shadow-sm p-6">
            <div class="quill-wrapper mb-3 border border-gray-300 rounded-lg overflow-hidden">
              <div id="quill-cur-elementary"></div>
            </div>
            <div class="flex items-center gap-3">
              <button data-key="curriculum_elementary" data-qid="quill-cur-elementary" class="save-content-btn bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90">저장</button>
              <span id="msg-curriculum_elementary" class="text-sm text-gray-500 hidden">저장되었습니다.</span>
            </div>
          </div>

          <div id="cur-sub-middle" class="hidden bg-white rounded-2xl shadow-sm p-6">
            <div class="quill-wrapper mb-3 border border-gray-300 rounded-lg overflow-hidden">
              <div id="quill-cur-middle"></div>
            </div>
            <div class="flex items-center gap-3">
              <button data-key="curriculum_middle" data-qid="quill-cur-middle" class="save-content-btn bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90">저장</button>
              <span id="msg-curriculum_middle" class="text-sm text-gray-500 hidden">저장되었습니다.</span>
            </div>
          </div>

          <div id="cur-sub-high" class="hidden bg-white rounded-2xl shadow-sm p-6">
            <div class="quill-wrapper mb-3 border border-gray-300 rounded-lg overflow-hidden">
              <div id="quill-cur-high"></div>
            </div>
            <div class="flex items-center gap-3">
              <button data-key="curriculum_high" data-qid="quill-cur-high" class="save-content-btn bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90">저장</button>
              <span id="msg-curriculum_high" class="text-sm text-gray-500 hidden">저장되었습니다.</span>
            </div>
          </div>
        </div>

        <!-- ── 강사소개 탭 ── -->
        <div id="panel-faculty" class="hidden">
          <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
            <h2 id="faculty-form-title" class="text-base font-bold text-gray-900 mb-4">강사 추가</h2>
            <input type="hidden" id="faculty-edit-id" />
            <div class="grid grid-cols-2 gap-3 mb-3">
              <select id="faculty-subject-input" class="border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand">
                <option value="수학">수학</option>
                <option value="영어">영어</option>
                <option value="과학">과학</option>
                <option value="국어">국어</option>
                <option value="탐독">탐독</option>
                <option value="원장">원장</option>
                <option value="부원장">부원장</option>
                <option value="연구원">연구원</option>
              </select>
              <input id="faculty-name-input" type="text" placeholder="이름" class="border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
            </div>
            <input id="faculty-motto-input" type="text" placeholder="한마디" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm mb-3 focus:outline-none focus:border-brand" />
            <div class="mb-3">
              <p class="text-xs text-gray-500 mb-2">소속 학부 (중복 선택 가능)</p>
              <div class="flex gap-4">
                <label class="flex items-center gap-1.5 text-sm text-gray-700 cursor-pointer"><input type="checkbox" class="faculty-div-check accent-brand" value="초등부" /> 초등부</label>
                <label class="flex items-center gap-1.5 text-sm text-gray-700 cursor-pointer"><input type="checkbox" class="faculty-div-check accent-brand" value="중등부" /> 중등부</label>
                <label class="flex items-center gap-1.5 text-sm text-gray-700 cursor-pointer"><input type="checkbox" class="faculty-div-check accent-brand" value="고등부" /> 고등부</label>
                <label class="flex items-center gap-1.5 text-sm text-gray-700 cursor-pointer"><input type="checkbox" class="faculty-div-check accent-brand" value="입시와대치" /> 입시와대치</label>
              </div>
            </div>
            <input id="faculty-role-input" type="text" placeholder="직책 (입시와대치만 해당: 원장/부원장/연구원)" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm mb-3 focus:outline-none focus:border-brand" />
            <div class="mb-4">
              <p class="text-xs text-gray-500 mb-2">프로필 사진</p>
              <input type="file" id="faculty-image-input" accept="image/*" class="text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer" />
              <img id="faculty-image-preview" class="hidden mt-2 w-20 h-20 object-cover object-top rounded-lg border border-gray-200" />
            </div>
            <div class="flex items-center gap-3">
              <button id="submit-faculty-btn" class="bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90 transition-opacity">추가</button>
              <button id="cancel-faculty-btn" class="hidden border border-gray-300 text-gray-600 rounded-lg px-6 py-2.5 text-sm font-semibold hover:bg-gray-50 transition-colors">취소</button>
              <p id="faculty-msg" class="text-sm text-gray-500 hidden"></p>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm p-6">
            <h2 class="text-base font-bold text-gray-900 mb-4">강사 목록</h2>
            <div id="faculty-list" class="divide-y divide-gray-100">
              <p class="text-sm text-gray-400 py-4 text-center">불러오는 중...</p>
            </div>
          </div>
        </div>

        <!-- ── 명예의 전당 탭 ── -->
        <div id="panel-results" class="hidden">
          <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
            <h2 class="text-base font-bold text-gray-900 mb-4">합격자 추가</h2>
            <div class="grid grid-cols-3 gap-3 mb-3">
              <input id="result-year-input"     type="text" placeholder="연도 (예: 2026)" class="border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
              <select id="result-category-input" class="border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand">
                <option value="대입">대입</option>
                <option value="고입">고입</option>
              </select>
              <input id="result-school-input"   type="text" placeholder="출신 학교" class="border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
            </div>
            <div class="grid grid-cols-3 gap-3 mb-4">
              <input id="result-name-input"       type="text" placeholder="이름" class="border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
              <input id="result-university-input" type="text" placeholder="합격 대학/고교" class="border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
              <input id="result-dept-input"       type="text" placeholder="학과 (대입만)" class="border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand" />
            </div>
            <div class="flex items-center gap-3">
              <button id="submit-result-btn" class="bg-brand text-white rounded-lg px-6 py-2.5 text-sm font-semibold hover:opacity-90 transition-opacity">추가</button>
              <p id="result-msg" class="text-sm text-gray-500 hidden"></p>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-base font-bold text-gray-900">합격자 목록</h2>
              <select id="result-year-filter" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-brand">
                <option value="">전체 연도</option>
              </select>
            </div>
            <div id="result-list" class="divide-y divide-gray-100">
              <p class="text-sm text-gray-400 py-4 text-center">불러오는 중...</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</Layout>

