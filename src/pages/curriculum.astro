---
import Layout from '../components/layout/Layout.astro';

const subjects = [
  { label: '국어',       id: 'korean',   key: 'curriculum_korean' },
  { label: '영어',       id: 'english',  key: 'curriculum_english' },
  { label: '수학',       id: 'math',     key: 'curriculum_math' },
  { label: '과학',       id: 'science',  key: 'curriculum_science' },
  { label: '탐독',       id: 'tamdoq',   key: 'curriculum_tamdoq' },
  { label: 'Management', id: 'entrance', key: 'curriculum_entrance' },
];

// Management 탭: 설명회 슬라이드(24~28p) 구성을 그대로 코드에 반영
const MGMT_SUBJECTS = [
  { subject: '수학', tag: '서술형 및 수준별 극심화', desc: '서술형 집중 연습과 실력에 따른 연산부터 극심화(응용문제 풀이)까지 완벽 마스터' },
  { subject: '영어', tag: '내신 대비 및 영작·서술형', desc: '시험 중심의 문법/독해/어휘는 기본, 서술형 글쓰기 및 영작문 완벽 훈련' },
  { subject: '국어', tag: '나랑국어 및 수능·내신', desc: '초중등 나랑국어 전문 프로그램 독서논술 및 국어 문제풀이력 향상, 고등 수능/내신 완벽 대비' },
  { subject: '과학', tag: '스토리텔링 및 내신·수능', desc: '흥미를 자극하는 스토리텔링형 과학(예정)과 고등 내신·수능으로 이어지는 체계적 연계' },
];

const MGMT_SYSTEM = [
  { num: '01', title: '스마트폰 전면 격리', desc: '등원 즉시 전용 수거함에 스마트폰을 반납하여 집중을 저해하는 요소를 원천 차단합니다.' },
  { num: '02', title: '방학 집중 몰입 [10to10]', desc: '오전 10시부터 밤 10시까지, 대치프라임 전용 몰입관을 가동하여 흐트러짐 없는 학습 환경을 제공합니다.' },
  { num: '03', title: '당일 과제 인증 시스템', desc: '"숙제는 내일해야지"는 통하지 않습니다. 당일 배운 핵심 개념과 과제는 반드시 오늘 스스로 완벽하게 처리합니다.' },
  { num: '04', title: 'Better Than Yesterday', desc: '주말 강제자습 — 평일 테스트 미달자 및 과제 미흡자는 주말 강제 소환 밀착 보강으로 스스로 집중할 수밖에 없는 견고한 시스템에 아이를 맡기십시오.' },
];

const MGMT_ASSESS = [
  { title: 'WT (Weekly Test)', items: ['매주 금요일/주말', '한 주간 배운 핵심 개념 응용 및 고난도 심화 평가'] },
  { title: '다양한 모의고사', items: ['고교선택 진단평가', '내신대비 모의평가', '자체 중간고사/기말고사', '시대인재/대성 사설고사'] },
  { title: '추가 서비스', items: ['자료제공 서비스: 수학/영어/국어/과학/역사/사회/기가까지', '주말 시험대비 자습'] },
];

// 정규반 시간표: 선생님들이 직접 편집하는 구글시트에서 불러옴 (탭 이름 = 과목명)
const TIMETABLE_SHEET_ID = '1ktrfPNbLn5dmBawtAXBag0kwFHRpYdK7cP10Ac6CR5Y';
const TIMETABLE_SHEET_NAMES: Record<string, string> = {
  korean: '국어',
  english: '영어',
  math: '수학',
  science: '과학',
};
---

<Layout title="커리큘럼 - 대치프라임" description="대치프라임학원 커리큘럼을 안내합니다.">
  <div class="min-h-screen bg-white">

    <div class="border-b border-gray-200">
      <div class="container mx-auto px-4 py-8">
        <h1 class="text-2xl font-bold text-gray-900">커리큘럼</h1>
      </div>
    </div>

    <!-- 2×3 그리드 탭 -->
    <div class="sticky top-[65px] z-40 bg-white border-b border-gray-200">
      <div class="container mx-auto px-4 py-4">
        <div class="grid grid-cols-2 border border-gray-200 rounded-sm overflow-hidden">
          {subjects.map((s, i) => (
            <button
              data-tab={s.id}
              data-key={s.key}
              class={`cur-tab py-4 text-sm font-medium border-r border-gray-200 transition-colors
                ${i < 4 ? 'border-b' : ''}
                ${i === 0
                  ? 'bg-brand text-white'
                  : s.id === 'entrance'
                    ? 'bg-brand-light text-brand font-bold hover:bg-brand-light'
                    : 'bg-white text-gray-500 hover:bg-gray-50'}`}
            >
              {s.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-16 max-w-3xl">
      {subjects.map((s, i) => (
        <div id={`panel-${s.id}`} class={`cur-panel ${i !== 0 ? 'hidden' : ''}`}>
          <h2 class="text-xl font-bold text-gray-900 mb-6">{s.label} 커리큘럼</h2>
          <div id={`content-${s.id}`} class="page-content-area text-gray-700 leading-relaxed">
            <p class="text-gray-400 text-sm text-center py-10">불러오는 중...</p>
          </div>

          {TIMETABLE_SHEET_NAMES[s.id] && (
            <div id={`timetable-${s.id}`} class="mt-12"></div>
          )}

          {s.id === 'entrance' && (
            <div class="mt-4 space-y-16">
              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">대치프라임과의 노력이 성적으로 전이되는 순간</h3>
                <p class="text-sm text-gray-500 mb-6">"지식을 단순히 주입하는 것과, 내 것으로 만들어 쏟아내는 것은 완전히 다른 기술입니다."</p>
                <div class="grid grid-cols-2 gap-4">
                  {MGMT_SUBJECTS.map((item) => (
                    <div class="rounded-xl border border-gray-200 bg-gray-50 p-5">
                      <h4 class="font-bold text-gray-900 mb-2">{item.subject}</h4>
                      <p class="text-xs font-semibold text-brand mb-2">{item.tag}</p>
                      <p class="text-xs text-gray-600 leading-relaxed">{item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">아이의 의지를 탓하지 마십시오. '환경'이 지배합니다</h3>
                <p class="text-sm text-gray-500 mb-6">"의지는 원래 약합니다. 스스로 몰입하도록 판을 짜는 것이 진짜 관리입니다."</p>
                <div class="grid grid-cols-2 gap-4">
                  {MGMT_SYSTEM.map((item) => (
                    <div class="rounded-xl border border-gray-200 p-5">
                      <span class="text-2xl font-black text-gray-200">{item.num}</span>
                      <h4 class="font-bold text-gray-900 mt-1 mb-2">{item.title}</h4>
                      <p class="text-xs text-gray-600 leading-relaxed">{item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">합격의 궤도를 걷는 선배들과의 강력한 동맹</h3>
                <p class="text-sm text-gray-500 mb-6">"엄마의 백 마디 잔소리보다, 가슴 뛰게 만드는 선배의 진짜 한 마디가 아이를 움직입니다."</p>
                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="rounded-xl border border-gray-200 p-6">
                    <h4 class="font-bold text-gray-900 mb-3">선배들과의 실시간 LIVE TALK</h4>
                    <p class="text-xs text-gray-600 leading-relaxed">방학 기간 중 생생한 과목별 필기법, 멘탈 관리법, 고등학교 생존 비법 전수 [고교 간담회]</p>
                  </div>
                  <div class="rounded-xl border border-gray-200 p-6">
                    <h4 class="font-bold text-gray-900 mb-3">Daechi Connect Alliance</h4>
                    <ul class="text-xs text-gray-600 leading-relaxed list-disc pl-4 space-y-1">
                      <li>SKY, 의치한, 전국단위 특목고에 진학한 대치프라임 졸업생 라인업 구축</li>
                      <li>막연한 동경을 넘어, 실제 선배들을 통한 합격 궤도 동기부여</li>
                    </ul>
                  </div>
                </div>
              </div>

              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">실력을 입증하는 빈틈없는 평가 시스템</h3>
                <p class="text-sm text-gray-500 mb-6">"평가는 단순히 점수를 내는 과정이 아닌, 학습의 빈틈을 가장 빠르게 메우는 핵심 치료제입니다."</p>
                <div class="grid sm:grid-cols-3 gap-4">
                  {MGMT_ASSESS.map((block) => (
                    <div class="rounded-xl border border-gray-200 p-5">
                      <h4 class="font-bold text-gray-900 mb-3">{block.title}</h4>
                      <ul class="text-xs text-gray-600 leading-relaxed list-disc pl-4 space-y-1">
                        {block.items.map((line) => <li>{line}</li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</Layout>

<style is:global>
  .page-content-area p { margin-bottom: 0.75rem; line-height: 1.8; }
  .page-content-area h1, .page-content-area h2, .page-content-area h3 {
    font-weight: 700; margin-bottom: 0.75rem; margin-top: 1.5rem; color: #111827;
  }
  .page-content-area h1 { font-size: 1.5rem; }
  .page-content-area h2 { font-size: 1.25rem; }
  .page-content-area h3 { font-size: 1.1rem; }
  .page-content-area ul, .page-content-area ol { padding-left: 1.5rem; margin-bottom: 0.75rem; }
  .page-content-area li { margin-bottom: 0.25rem; }
  .page-content-area img { max-width: 100%; border-radius: 8px; margin: 8px 0; }
  .page-content-area strong { font-weight: 700; }
  .page-content-area em { font-style: italic; }
  .page-content-area a { color: var(--color-brand, #6B4EE6); text-decoration: underline; }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const subjects = [
    { id: 'korean',   key: 'curriculum_korean' },
    { id: 'english',  key: 'curriculum_english' },
    { id: 'math',     key: 'curriculum_math' },
    { id: 'science',  key: 'curriculum_science' },
    { id: 'tamdoq',   key: 'curriculum_tamdoq' },
    { id: 'entrance', key: 'curriculum_entrance' },
  ];

  async function loadContent(key: string, elId: string) {
    const { data } = await supabase.from('page_content').select('value').eq('key', key).single();
    const el = document.getElementById(elId);
    if (!el) return;
    if (data?.value && data.value.trim() !== '' && data.value !== '<p><br></p>') {
      el.innerHTML = data.value;
    } else {
      el.classList.add('hidden');
    }
  }

  function init() {
    const tabs   = document.querySelectorAll<HTMLButtonElement>('.cur-tab');
    const panels = document.querySelectorAll<HTMLElement>('.cur-panel');

    function activate(id: string) {
      tabs.forEach(t => {
        t.classList.remove('bg-brand', 'text-white', 'bg-brand-light', 'text-brand', 'font-bold');
        if (t.dataset.tab === 'entrance') {
          t.classList.add('bg-brand-light', 'text-brand', 'font-bold');
        } else {
          t.classList.add('bg-white', 'text-gray-500');
        }
      });
      const active = document.querySelector<HTMLButtonElement>(`.cur-tab[data-tab="${id}"]`);
      active?.classList.remove('bg-white', 'text-gray-500', 'bg-brand-light', 'text-brand', 'font-bold');
      active?.classList.add('bg-brand', 'text-white');
      panels.forEach(p => p.classList.add('hidden'));
      document.getElementById(`panel-${id}`)?.classList.remove('hidden');
    }

    tabs.forEach(tab => tab.addEventListener('click', () => activate(tab.dataset.tab!)));

    subjects.forEach(s => loadContent(s.key, `content-${s.id}`));
    loadTimetables();
  }

  // ──────────────────────────────────────────
  // 정규반 시간표: 구글시트(선생님 편집) → XLSX 내보내기 → 클라이언트에서 파싱
  // ──────────────────────────────────────────
  const SHEET_ID = '1ktrfPNbLn5dmBawtAXBag0kwFHRpYdK7cP10Ac6CR5Y';
  const SHEET_NAMES: Record<string, string> = {
    korean: '국어',
    english: '영어',
    math: '수학',
    science: '과학',
  };
  const GROUP_ORDER = ['초등', '중등', '고1', '고2·3', '고등'];

  async function loadXlsxLib() {
    if ((window as any).XLSX) return;
    await new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
      script.onload = () => resolve();
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  function escHtml(str: unknown) {
    return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderTimetable(rows: any[][]): string {
    // rows: [구분, 학년, 반명, 수업시간, 강사, 사용교재][] (헤더 제외)
    const groups = new Map<string, any[][]>();
    rows.forEach(r => {
      const g = String(r[0] ?? '').trim() || '기타';
      if (!groups.has(g)) groups.set(g, []);
      groups.get(g)!.push(r);
    });

    const sortedGroups = [...groups.keys()].sort((a, b) => {
      const ia = GROUP_ORDER.indexOf(a), ib = GROUP_ORDER.indexOf(b);
      return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
    });

    return sortedGroups.map(g => {
      const groupRows = groups.get(g)!;
      const cardRows = groupRows.map(r => {
        const [, grade, className, time, teacher, book] = r;
        const nameLabel = [grade, className].filter(Boolean).join(' ');
        return `
          <div class="border-b border-gray-100 py-3 last:border-b-0">
            <div class="flex items-baseline justify-between gap-3">
              <p class="text-sm font-bold text-gray-900">${escHtml(nameLabel)}</p>
              <p class="text-xs text-gray-500 whitespace-nowrap">${escHtml(time)}</p>
            </div>
            <p class="text-xs text-gray-500 mt-0.5">${escHtml(teacher)}</p>
            <p class="text-xs text-gray-600 mt-1 leading-relaxed">${escHtml(book)}</p>
          </div>`;
      }).join('');

      const tableRows = groupRows.map(r => {
        const [, grade, className, time, teacher, book] = r;
        const nameLabel = [grade, className].filter(Boolean).join(' ');
        return `
          <tr class="border-b border-gray-100">
            <td class="py-2.5 pr-4 text-sm font-semibold text-gray-900 whitespace-nowrap align-top">${escHtml(nameLabel)}</td>
            <td class="py-2.5 pr-4 text-sm text-gray-600 whitespace-nowrap align-top">${escHtml(time)}</td>
            <td class="py-2.5 pr-4 text-sm text-gray-600 whitespace-nowrap align-top">${escHtml(teacher)}</td>
            <td class="py-2.5 text-sm text-gray-600 align-top">${escHtml(book)}</td>
          </tr>`;
      }).join('');

      return `
        <div class="mb-8 last:mb-0">
          <h3 class="text-sm font-bold text-gray-900 mb-2">${escHtml(g)} 정규반</h3>
          <div class="sm:hidden">${cardRows}</div>
          <table class="hidden sm:table w-full border-collapse">
            <thead>
              <tr class="border-b-2 border-black">
                <th class="text-left text-xs font-bold text-gray-900 py-2 pr-4 whitespace-nowrap">반명</th>
                <th class="text-left text-xs font-bold text-gray-900 py-2 pr-4 whitespace-nowrap">수업시간</th>
                <th class="text-left text-xs font-bold text-gray-900 py-2 pr-4 whitespace-nowrap">강사</th>
                <th class="text-left text-xs font-bold text-gray-900 py-2">사용교재</th>
              </tr>
            </thead>
            <tbody>${tableRows}</tbody>
          </table>
        </div>`;
    }).join('');
  }

  async function loadTimetables() {
    const targets = Object.keys(SHEET_NAMES).filter(id => document.getElementById(`timetable-${id}`));
    if (targets.length === 0) return;

    try {
      await loadXlsxLib();
      const res = await fetch(`https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=xlsx`);
      if (!res.ok) throw new Error('sheet fetch failed');
      const buf = await res.arrayBuffer();
      const XLSX = (window as any).XLSX;
      const wb = XLSX.read(buf, { type: 'array' });

      targets.forEach(id => {
        const el = document.getElementById(`timetable-${id}`);
        if (!el) return;
        const sheetName = SHEET_NAMES[id];
        const sheet = wb.Sheets[sheetName];
        if (!sheet) { el.innerHTML = ''; return; }
        const rows: any[][] = XLSX.utils.sheet_to_json(sheet, { header: 1 }).slice(1).filter((r: any[]) => r.some(c => c !== undefined && c !== ''));
        el.innerHTML = rows.length > 0 ? renderTimetable(rows) : '';
      });
    } catch {
      // 시간표 로드 실패는 조용히 무시 (Quill 본문 내용은 이미 표시됨)
    }
  }

  document.addEventListener('astro:page-load', init);
</script>
