---
import Layout from '../components/layout/Layout.astro';

const divisions = ['임원진', '초등부', '중등부', '고등부', '입시와대치'];
---

<Layout title="강사소개 - 대치프라임" description="대치프라임 강사진을 소개합니다.">

  <div class="min-h-screen bg-white">

    <div class="border-b border-gray-200 bg-white">
      <div class="container mx-auto px-4 py-8">
        <h1 class="text-2xl font-bold text-gray-900">강사소개</h1>
      </div>
    </div>

    <!-- 학부 탭 -->
    <div class="sticky top-[65px] z-40 bg-white border-b border-gray-200">
      <div class="container mx-auto px-4">
        <div class="flex overflow-x-auto scrollbar-hide" id="division-tabs">
          {divisions.map((d, i) => (
            <button
              data-division={d}
              class={`division-tab flex-shrink-0 px-6 py-4 text-sm font-medium border-b-2 transition-colors whitespace-nowrap
                ${i === 0
                  ? 'border-gray-900 text-gray-900'
                  : 'border-transparent text-gray-500 hover:text-gray-800'}`}
            >
              {d}
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-10">
      <div id="loading" class="text-center py-24 text-gray-400 text-sm">불러오는 중...</div>
      <div id="faculty-grid" class="hidden grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto"></div>
      <div id="empty-msg" class="hidden text-center py-20 text-gray-400 text-sm">해당 학부 강사 정보를 준비 중입니다.</div>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const subjectColors: Record<string, string> = {
    '수학': 'text-blue-500',
    '영어': 'text-green-500',
    '과학': 'text-orange-500',
    '국어': 'text-brand',
    '탐독': 'text-purple-500',
    '원장': 'text-gray-900',
    '부원장': 'text-gray-700',
    '연구원': 'text-gray-500',
  };

  let allFaculty: any[] = [];
  let currentDivision = '임원진';

  function koreanSort(a: any, b: any) {
    return a.name.localeCompare(b.name, 'ko');
  }

  function renderCards(division: string) {
    currentDivision = division;
    const grid    = document.getElementById('faculty-grid')!;
    const emptyEl = document.getElementById('empty-msg')!;

    const filtered = allFaculty
      .filter(f => Array.isArray(f.divisions) && f.divisions.includes(division))
      .sort((division === '입시와대치' || division === '임원진') ? roleSort : koreanSort);

    if (filtered.length === 0) {
      grid.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    grid.classList.remove('hidden');
    grid.innerHTML = filtered.map(f => {
      const label = ((division === '입시와대치' || division === '임원진') && f.role) ? f.role : f.subject;
      const color = subjectColors[label] ?? 'text-gray-500';
      return `
        <div class="bg-gray-50 rounded-xl overflow-hidden hover:shadow-md transition-shadow">
          <div class="relative aspect-[3/4] bg-gray-200">
            <img
              src="${esc(f.image_url || '')}"
              alt="${esc(f.name)}"
              class="w-full h-full object-cover object-top"
              onerror="this.src='/images/faculty-placeholder-1.jpg'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
          </div>
          <div class="px-4 py-3">
            <p class="text-xs font-semibold mb-0.5 ${color}">${esc(label)}</p>
            <p class="text-sm font-bold text-gray-900 mb-2">${esc(f.name)} 선생님</p>
            <p class="text-xs text-gray-400 leading-relaxed border-t border-gray-100 pt-2">${esc(f.motto ?? '')}</p>
          </div>
        </div>
      `;
    }).join('');
  }

  // 입시와대치는 원장 > 부원장 > 연구원 순
  const roleOrder: Record<string, number> = { '원장': 0, '부원장': 1, '연구원': 2 };
  function roleSort(a: any, b: any) {
    const ra = roleOrder[a.role] ?? 9;
    const rb = roleOrder[b.role] ?? 9;
    if (ra !== rb) return ra - rb;
    return a.name.localeCompare(b.name, 'ko');
  }

  function esc(str: string) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  async function init() {
    const { data, error } = await supabase
      .from('faculty')
      .select('*')
      .order('sort_order')
      .order('id');

    if (!document.getElementById('loading')) return;
    document.getElementById('loading')?.classList.add('hidden');

    if (error || !data) {
      document.getElementById('empty-msg')!.classList.remove('hidden');
      return;
    }

    allFaculty = data;
    renderCards('임원진');

    // 탭 이벤트
    const tabs = document.querySelectorAll<HTMLButtonElement>('.division-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('border-gray-900', 'text-gray-900');
          t.classList.add('border-transparent', 'text-gray-500');
        });
        tab.classList.add('border-gray-900', 'text-gray-900');
        tab.classList.remove('border-transparent', 'text-gray-500');
        renderCards(tab.dataset.division ?? '초등부');
      });
    });
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
