---
import Layout from '../components/layout/Layout.astro';
---

<Layout title="진단 평가 분석 리포트 - 대치프라임" description="대치프라임학원 자체 진단 평가 분석 리포트 및 기말고사 스케치">

<div class="min-h-screen bg-gray-50">

  <!-- 페이지 헤더 -->
  <div class="border-b border-gray-200 bg-white">
    <div class="container mx-auto px-4 py-8">
      <p class="text-sm text-brand font-semibold mb-1">대치프라임 자체 평가</p>
      <h1 class="text-2xl font-bold text-gray-900">진단 평가 분석 리포트</h1>
      <p class="text-sm text-gray-500 mt-1">2026년 7월 3일 시행 · 초등부~중등부</p>
    </div>
  </div>

  <!-- 메인 탭 -->
  <div class="bg-white border-b border-gray-200 sticky top-[65px] z-40">
    <div class="container mx-auto px-4">
      <div class="flex gap-0">
        <button id="main-tab-report" class="main-tab px-6 py-4 text-sm font-semibold border-b-2 border-brand text-brand transition-colors">
          진단 평가 분석
        </button>
        <button id="main-tab-sketch" class="main-tab px-6 py-4 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors">
          자체 기말고사 스케치
        </button>
      </div>
    </div>
  </div>

  <!-- ── 패널 1: 진단 평가 분석 ── -->
  <div id="panel-report" class="container mx-auto px-4 py-8 max-w-4xl">

    <!-- 학년 선택 -->
    <div class="mb-6">
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">학년 선택</p>
      <div class="flex gap-2 flex-wrap">
        {['초5', '초6', '중1'].map((g, i) => (
          <button
            data-grade={g}
            class={`grade-btn px-5 py-2.5 rounded-lg text-sm font-semibold border transition-colors
              ${i === 0 ? 'bg-brand text-white border-brand' : 'bg-white text-gray-600 border-gray-200 hover:border-brand hover:text-brand'}`}
          >{g}</button>
        ))}
      </div>
    </div>

    <!-- 과목 선택 -->
    <div class="mb-8">
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">과목 선택</p>
      <div class="flex gap-2">
        {['수학', '영어'].map((s, i) => (
          <button
            data-subject={s}
            class={`subject-btn px-5 py-2.5 rounded-lg text-sm font-semibold border transition-colors
              ${i === 0 ? 'bg-brand text-white border-brand' : 'bg-white text-gray-600 border-gray-200 hover:border-brand hover:text-brand'}`}
          >{s}</button>
        ))}
      </div>
    </div>

    <!-- 리포트 컨텐츠 -->
    <div id="report-content">
      <p class="text-center text-gray-400 py-20">학년과 과목을 선택하세요.</p>
    </div>

  </div>

  <!-- ── 패널 2: 자체 기말고사 스케치 ── -->
  <div id="panel-sketch" class="hidden container mx-auto px-4 py-8 max-w-5xl">
    <div class="mb-6">
      <h2 class="text-lg font-bold text-gray-900">자체 기말고사 스케치</h2>
      <p class="text-sm text-gray-500 mt-1">2026년 1학기 자체 기말고사 현장 사진</p>
    </div>
    <div id="sketch-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <div class="col-span-full text-center py-16 text-gray-400">
        <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <p class="text-sm">사진을 불러오는 중...</p>
      </div>
    </div>
  </div>

</div>

</Layout>

<script>
  import { supabase } from '../lib/supabase';

  /* ──────────────────────────────────────────
     리포트 데이터 (DB: exam_reports 에서 로드)
  ────────────────────────────────────────── */
  let REPORTS: Record<string, Record<string, any>> = {};

  async function loadReports() {
    const { data, error } = await supabase.from('exam_reports').select('*');
    REPORTS = {};
    if (!error && data) {
      data.forEach((r: any) => {
        if (!REPORTS[r.grade]) REPORTS[r.grade] = {};
        REPORTS[r.grade][r.subject] = {
          date: r.exam_date,
          total: r.total,
          difficultyLevel: r.difficulty_level,
          scope: r.scope,
          overview: r.overview,
          sections: r.sections ?? [],
          parentGuide: r.parent_guide,
        };
      });
    }
  }

  /* ──────────────────────────────────────────
     상태
  ────────────────────────────────────────── */
  let currentGrade = '초5';
  let currentSubject = '수학';

  /* ──────────────────────────────────────────
     렌더링 유틸
  ────────────────────────────────────────── */
  function stars(n: number, max = 5) {
    return Array.from({ length: max }, (_, i) =>
      `<span class="${i < n ? 'text-yellow-400' : 'text-gray-200'}">★</span>`
    ).join('');
  }

  function renderSection(sec: any): string {
    if (sec.type === 'list') {
      return `
        <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-gray-900 mb-3">
            ${sec.title}
          </h3>
          <ul class="space-y-1.5">
            ${sec.items.map((item: string) => `
              <li class="flex items-start gap-2 text-sm text-gray-700">
                <span class="text-brand mt-0.5 flex-shrink-0">·</span>
                <span>${item}</span>
              </li>
            `).join('')}
          </ul>
        </div>`;
    }

    if (sec.type === 'difficulty') {
      const colorMap: Record<string, string> = {
        red: 'bg-red-50 text-red-700 border-red-200',
        yellow: 'bg-yellow-50 text-yellow-700 border-yellow-200',
        green: 'bg-green-50 text-green-700 border-green-200',
      };
      return `
        <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-gray-900 mb-4">
            ${sec.title}
          </h3>
          <div class="space-y-3">
            ${sec.rows.map((row: any) => `
              <div class="flex gap-3 items-start">
                <span class="flex-shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg text-xs font-bold border ${colorMap[row.color]}">${row.level}</span>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-bold text-gray-500 mb-0.5">${row.items}</p>
                  <p class="text-sm text-gray-700">${row.desc}</p>
                </div>
              </div>
            `).join('')}
          </div>
        </div>`;
    }

    if (sec.type === 'keypoints') {
      return `
        <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-gray-900 mb-4">
            ${sec.title}
          </h3>
          <div class="space-y-3">
            ${sec.items.map((item: any) => `
              <div class="flex gap-4 p-4 bg-gray-50 rounded-xl">
                <span class="text-2xl font-black text-gray-200 flex-shrink-0 leading-none">${item.num}</span>
                <div>
                  <p class="text-sm font-bold text-gray-900 mb-1">${item.title}</p>
                  <p class="text-sm text-gray-600 leading-relaxed">${item.desc}</p>
                </div>
              </div>
            `).join('')}
          </div>
        </div>`;
    }

    if (sec.type === 'area-table') {
      return `
        <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-gray-900 mb-4">
            ${sec.title}
          </h3>
          <div class="space-y-3">
            ${sec.rows.map((row: any) => `
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-gray-800">${row.area}</span>
                  <span class="text-xs text-gray-500">${row.count} · <strong class="text-brand">${row.pct}</strong></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2">
                  <div class="bg-brand h-2 rounded-full" style="width:${row.width}%"></div>
                </div>
                <p class="text-xs text-gray-500 mt-1">${row.key}</p>
              </div>
            `).join('')}
          </div>
        </div>`;
    }

    if (sec.type === 'key-items') {
      return `
        <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-gray-900 mb-4">
            ${sec.title}
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-100">
                  <th class="text-left py-2 pr-4 text-xs text-gray-400 font-semibold w-12">문항</th>
                  <th class="text-left py-2 pr-4 text-xs text-gray-400 font-semibold">난이도</th>
                  <th class="text-left py-2 pr-4 text-xs text-gray-400 font-semibold">평가 핵심 개념</th>
                  <th class="text-left py-2 text-xs text-gray-400 font-semibold">핵심 오답 원인</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50">
                ${sec.rows.map((row: any) => `
                  <tr>
                    <td class="py-2.5 pr-4 font-bold text-gray-900">${row.num}</td>
                    <td class="py-2.5 pr-4 whitespace-nowrap">${stars(row.stars)}</td>
                    <td class="py-2.5 pr-4 text-gray-700">${row.concept}</td>
                    <td class="py-2.5 text-gray-600">${row.cause}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>`;
    }

    if (sec.type === 'capability') {
      return `
        <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-gray-900 mb-4">
            ${sec.title}
          </h3>
          <div class="space-y-3">
            ${sec.rows.map((row: any) => `
              <div class="flex items-start gap-3">
                <span class="text-sm font-bold text-gray-800 w-28 flex-shrink-0">${row.name}</span>
                <span class="flex-shrink-0">${stars(row.stars)}</span>
                <span class="text-sm text-gray-600">${row.desc}</span>
              </div>
            `).join('')}
          </div>
        </div>`;
    }

    if (sec.type === 'mistake-rank') {
      return `
        <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-gray-900 mb-4">
            ${sec.title}
          </h3>
          <div class="space-y-2">
            ${sec.rows.map((row: any) => `
              <div class="flex items-start gap-3 p-3 bg-orange-50 rounded-lg border border-orange-100">
                <span class="text-xs font-black text-orange-600 w-8 flex-shrink-0">${row.rank}</span>
                <div>
                  <p class="text-sm font-bold text-gray-900">${row.type}</p>
                  <p class="text-xs text-gray-600 mt-0.5">${row.cause}</p>
                </div>
              </div>
            `).join('')}
          </div>
        </div>`;
    }

    if (sec.type === 'prescription') {
      return `
        <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <h3 class="text-sm font-bold text-gray-900 mb-4">
            ${sec.title}
          </h3>
          <div class="space-y-3">
            ${sec.items.map((item: any) => `
              <div class="p-4 border border-brand/20 bg-brand/5 rounded-xl">
                <p class="text-sm font-bold text-brand mb-1">${item.unit} 단원</p>
                <p class="text-sm text-gray-700 leading-relaxed">${item.rx}</p>
              </div>
            `).join('')}
          </div>
        </div>`;
    }

    return '';
  }

  function renderReport() {
    const content = document.getElementById('report-content');
    if (!content) return;

    const data = REPORTS[currentGrade]?.[currentSubject];

    if (!data) {
      content.innerHTML = `
        <div class="text-center py-20">
          <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <p class="text-gray-500 font-semibold">${currentGrade} ${currentSubject} 분석 리포트를 준비 중입니다.</p>
          <p class="text-sm text-gray-400 mt-1">빠른 시일 내에 업로드하겠습니다.</p>
        </div>`;
      return;
    }

    content.innerHTML = `
      <!-- 개요 카드 -->
      <div class="bg-brand text-white rounded-2xl p-6 mb-6 shadow-lg">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-sm font-black opacity-80">${currentGrade} · ${currentSubject}</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-white/20 font-semibold">${data.difficultyLevel}</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-4">
          <div>
            <p class="text-xs opacity-70 mb-0.5">시험일</p>
            <p class="text-sm font-bold">${data.date}</p>
          </div>
          <div>
            <p class="text-xs opacity-70 mb-0.5">총 문항</p>
            <p class="text-sm font-bold">${data.total}</p>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <p class="text-xs opacity-70 mb-0.5">시험 범위</p>
            <p class="text-sm font-bold">${data.scope}</p>
          </div>
        </div>
        <p class="text-sm leading-relaxed opacity-90">${data.overview}</p>
      </div>

      <!-- 섹션들 -->
      <div class="space-y-4">
        ${data.sections.map((sec: any) => renderSection(sec)).join('')}
      </div>

      <!-- 학부모 가이드 -->
      <div class="mt-6 bg-blue-50 border border-blue-100 rounded-xl p-5">
        <h3 class="text-sm font-bold text-blue-900 mb-2">
          학부모님 가이드
        </h3>
        <p class="text-sm text-blue-800 leading-relaxed">${data.parentGuide}</p>
      </div>
    `;
  }

  /* ──────────────────────────────────────────
     탭 전환
  ────────────────────────────────────────── */
  function switchMainTab(tab: 'report' | 'sketch') {
    document.getElementById('panel-report')?.classList.toggle('hidden', tab !== 'report');
    document.getElementById('panel-sketch')?.classList.toggle('hidden', tab !== 'sketch');

    document.querySelectorAll<HTMLButtonElement>('.main-tab').forEach(btn => {
      const isActive = btn.id === `main-tab-${tab}`;
      btn.classList.toggle('border-brand', isActive);
      btn.classList.toggle('text-brand', isActive);
      btn.classList.toggle('border-transparent', !isActive);
      btn.classList.toggle('text-gray-500', !isActive);
    });

    if (tab === 'sketch') loadSketchPhotos();
  }

  /* ──────────────────────────────────────────
     자체 기말고사 스케치 사진
  ────────────────────────────────────────── */
  async function loadSketchPhotos() {
    const grid = document.getElementById('sketch-grid');
    if (!grid || grid.dataset.loaded === 'true') return;

    const { supabase } = await import('../lib/supabase');
    const { data, error } = await supabase.storage.from('exam-sketch').list('', { sortBy: { column: 'name', order: 'asc' } });

    if (error || !data || data.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full text-center py-16 text-gray-400">
          <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-sm font-medium">아직 등록된 사진이 없습니다.</p>
          <p class="text-xs mt-1">Supabase Storage &gt; exam-sketch 버킷에 사진을 업로드하면 여기에 표시됩니다.</p>
        </div>`;
      return;
    }

    const BUCKET_URL = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/exam-sketch`;
    grid.innerHTML = data
      .filter(f => f.name.match(/\.(jpg|jpeg|png|webp|gif)$/i))
      .map(f => `
        <div class="aspect-square overflow-hidden rounded-xl bg-gray-100 cursor-pointer" onclick="openPhoto('${BUCKET_URL}/${f.name}')">
          <img src="${BUCKET_URL}/${f.name}" alt="${f.name}"
               class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </div>
      `).join('');

    grid.dataset.loaded = 'true';
  }

  /* ──────────────────────────────────────────
     이벤트 등록
  ────────────────────────────────────────── */
  function init() {
    document.getElementById('main-tab-report')?.addEventListener('click', () => switchMainTab('report'));
    document.getElementById('main-tab-sketch')?.addEventListener('click', () => switchMainTab('sketch'));

    document.querySelectorAll<HTMLButtonElement>('.grade-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentGrade = btn.dataset.grade!;
        document.querySelectorAll<HTMLButtonElement>('.grade-btn').forEach(b => {
          const a = b.dataset.grade === currentGrade;
          b.classList.toggle('bg-brand', a); b.classList.toggle('text-white', a); b.classList.toggle('border-brand', a);
          b.classList.toggle('bg-white', !a); b.classList.toggle('text-gray-600', !a); b.classList.toggle('border-gray-200', !a);
        });
        renderReport();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.subject-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentSubject = btn.dataset.subject!;
        document.querySelectorAll<HTMLButtonElement>('.subject-btn').forEach(b => {
          const a = b.dataset.subject === currentSubject;
          b.classList.toggle('bg-brand', a); b.classList.toggle('text-white', a); b.classList.toggle('border-brand', a);
          b.classList.toggle('bg-white', !a); b.classList.toggle('text-gray-600', !a); b.classList.toggle('border-gray-200', !a);
        });
        renderReport();
      });
    });

    const content = document.getElementById('report-content');
    if (content) content.innerHTML = '<p class="text-center text-gray-400 py-20">불러오는 중...</p>';
    loadReports().then(renderReport);
  }

  document.addEventListener('astro:page-load', init);
</script>

<script is:inline>
  function openPhoto(url) {
    const overlay = document.createElement('div');
    overlay.className = 'fixed inset-0 z-[100] bg-black/80 flex items-center justify-center p-4 cursor-pointer';
    overlay.onclick = () => overlay.remove();
    overlay.innerHTML = `<img src="${url}" class="max-w-full max-h-full rounded-xl shadow-2xl object-contain" />`;
    document.body.appendChild(overlay);
  }
</script>
