                            <span class="break-keep">2027학년도 시흥 예비고1 고교선택 핵심 분석 가이드북 (고교별 과목 편제 일람표 수록) 100% 증정</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- 우측: 예약 폼 -->
            <div class="bg-white text-gray-900 p-8 md:p-10 rounded-3xl shadow-2xl relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-blue-600 to-yellow-400"></div>
                <h3 class="text-2xl font-bold mb-8 text-center">고교선택 전략 설명회 좌석 신청</h3>

                <form id="bookingForm" class="space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label for="studentName" class="block text-sm font-bold text-gray-700 mb-2">학생 성명 <span class="text-red-500">*</span></label>
                            <input type="text" id="studentName" required class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3.5 transition" placeholder="예: 홍길동" />
                        </div>
                        <div>
                            <label for="middleSchool" class="block text-sm font-bold text-gray-700 mb-2">현재 재학 중학교 <span class="text-red-500">*</span></label>
                            <input type="text" id="middleSchool" required class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3.5 transition" placeholder="예: 장곡중학교" />
                        </div>
                    </div>

                    <div>
                        <label for="parentPhone" class="block text-sm font-bold text-gray-700 mb-2">학부모 연락처 <span class="text-red-500">*</span></label>
                        <input type="tel" id="parentPhone" required pattern="[0-9]{2,3}-[0-9]{3,4}-[0-9]{4}" class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3.5 transition" placeholder="010-0000-0000" />
                    </div>

                    <div>
                        <label for="targetHigh" class="block text-sm font-bold text-gray-700 mb-2">관심 고등학교</label>
                        <select id="targetHigh" class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3.5 transition appearance-none">
                            <option value="">선택해 주세요 (선택)</option>
                            <option value="능곡고">시흥능곡고등학교</option>
                            <option value="장곡고">장곡고등학교</option>
                            <option value="시흥고">시흥고등학교</option>
                            <option value="소래고">소래고등학교</option>
                            <option value="함현고">함현고등학교</option>
                            <option value="특목자사">특목·자사·마이스터고</option>
                            <option value="기타">기타 관외 및 미정</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-3">설명회 일정 선택 (택 1) <span class="text-red-500">*</span></label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <label class="relative flex items-start gap-3 p-4 rounded-xl hover:bg-gray-50 border border-gray-200 transition cursor-pointer">
                                <input type="radio" name="selectedSeminar" value="장곡관 (8/28)" required class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500" />
                                <div>
                                    <span class="text-sm font-bold text-gray-800 block">[장곡관] 고교선택 설명회</span>
                                    <span class="text-xs text-gray-500 block mt-0.5">8월 28일(금) 오후 7:00</span>
                                </div>
                            </label>
                            <label class="relative flex items-start gap-3 p-4 rounded-xl hover:bg-gray-50 border border-gray-200 transition cursor-pointer">
                                <input type="radio" name="selectedSeminar" value="능곡관 (8/29)" class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500" />
                                <div>
                                    <span class="text-sm font-bold text-gray-800 block">[능곡관] 고교선택 설명회</span>
                                    <span class="text-xs text-gray-500 block mt-0.5">8월 29일(토) 오후 2:00</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 pt-2">
                        <input type="checkbox" id="privacy" required class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                        <label for="privacy" class="text-xs text-gray-500">개인정보 수집 및 안내 문자 전송에 동의합니다. (필수)</label>
                    </div>

                    <p id="formError" class="text-sm text-red-500 hidden"></p>

                    <div class="pt-2">
                        <button type="submit" id="submitBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl transition shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 text-lg flex justify-center items-center disabled:opacity-50">
                            <span>설명회 좌석 예약 완료하기</span>
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 text-center mt-4 break-keep">
                        입력하신 정보는 상담 및 예약 확인 목적으로만 사용됩니다.
                    </p>
                </form>
            </div>
        </div>
    </section>

    <!-- 푸터 -->
    <footer class="bg-gray-100 text-center py-10 text-gray-500 text-sm border-t border-gray-200">
        <div class="max-w-5xl mx-auto px-4">
            <h2 class="text-lg font-bold text-gray-700 mb-2">대치프라임학원</h2>
            <p class="mb-4">능곡관: 경기도 시흥시 장현능곡로 178 5층 전체 | 장곡관: 경기도 시흥시 장곡1로 11 4층 일부</p>
            <p>© 2026 대치프라임. All rights reserved.</p>
        </div>
    </footer>

    <!-- 예약 완료 모달 -->
    <div id="successModal" class="fixed inset-0 z-[100] flex items-center justify-center hidden bg-black/60 backdrop-blur-sm transition-opacity">
        <div class="bg-white rounded-2xl p-8 max-w-sm w-full mx-4 shadow-2xl transform scale-95 transition-transform" id="modalContent">
            <div class="text-center">
                <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-6">
                    <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">설명회 신청이 완료되었습니다!</h3>
                <p class="text-gray-600 mb-6 break-keep">
                    입력해 주신 번호로 담당 실장님이 확인 문자를 발송해 드릴 예정입니다. 대치프라임을 신뢰해 주셔서 고맙습니다.
                </p>
                <button id="modalCloseBtn" class="w-full inline-flex justify-center rounded-xl border border-transparent shadow-sm px-4 py-3 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition">
                    확인
                </button>
            </div>
        </div>
    </div>

    <!-- 로직 + Supabase 저장 -->
    <script>
        import { supabase } from '../lib/supabase';

        // ── 탭 전환 ──
        const tabButtons = document.querySelectorAll('.tab-btn');
        const tabPanes = document.querySelectorAll('.tab-pane');

        tabButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const tabId = btn.getAttribute('data-tab');

                tabPanes.forEach(pane => {
                    pane.classList.add('hidden');
                    pane.classList.remove('block');
                });

                const targetPane = document.getElementById(`${tabId}-content`);
                if (targetPane) {
                    targetPane.classList.remove('hidden');
                    targetPane.classList.add('block');
                }

                tabButtons.forEach(button => {
                    button.classList.remove('bg-blue-600', 'text-white', 'shadow-md');
                    button.classList.add('bg-white', 'text-gray-600', 'hover:bg-gray-200', 'shadow-sm');
                });

                btn.classList.remove('bg-white', 'text-gray-600', 'hover:bg-gray-200', 'shadow-sm');
                btn.classList.add('bg-blue-600', 'text-white', 'shadow-md');
            });
        });

        // ── "나에게 어울리는 고교는?" → 진단평가(tab2)로 이동 ──
        const navigateBtn = document.getElementById('navigate-to-diagnostic');
        navigateBtn?.addEventListener('click', () => {
            (document.getElementById('btn-tab2') as HTMLButtonElement | null)?.click();
            document.getElementById('programs')?.scrollIntoView({ behavior: 'smooth' });
        });

        // ── 예약 폼 ──
        const form = document.getElementById('bookingForm') as HTMLFormElement | null;
        const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
        const errorEl = document.getElementById('formError');
        const modal = document.getElementById('successModal');
        const modalContent = document.getElementById('modalContent');

        const showError = (msg: string) => {
            if (!errorEl) return;
            errorEl.textContent = msg;
            errorEl.classList.remove('hidden');
        };

        function openModal() {
            modal?.classList.remove('hidden');
            setTimeout(() => {
                modalContent?.classList.remove('scale-95');
                modalContent?.classList.add('scale-100');
            }, 10);
        }

        function closeModal() {
            modalContent?.classList.remove('scale-100');
            modalContent?.classList.add('scale-95');
            setTimeout(() => {
                modal?.classList.add('hidden');
                form?.reset();
            }, 200);
        }

        document.getElementById('modalCloseBtn')?.addEventListener('click', closeModal);

        // 전화번호 자동 하이픈
        document.getElementById('parentPhone')?.addEventListener('input', function (this: HTMLInputElement) {
            const val = this.value.replace(/[^0-9]/g, '');
            let res = '';
            if (val.length < 4) res = val;
            else if (val.length < 7) res = val.substr(0, 3) + '-' + val.substr(3);
            else if (val.length < 11) res = val.substr(0, 3) + '-' + val.substr(3, 3) + '-' + val.substr(6);
            else res = val.substr(0, 3) + '-' + val.substr(3, 4) + '-' + val.substr(7);
            this.value = res;
        });

        form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorEl?.classList.add('hidden');

            const name = (document.getElementById('studentName') as HTMLInputElement).value.trim();
            const middleSchool = (document.getElementById('middleSchool') as HTMLInputElement).value.trim();
            const phone = (document.getElementById('parentPhone') as HTMLInputElement).value.trim();
            const targetHigh = (document.getElementById('targetHigh') as HTMLSelectElement).value;
            const campus = (document.querySelector('input[name="selectedSeminar"]:checked') as HTMLInputElement | null)?.value;
            const privacyChecked = (document.getElementById('privacy') as HTMLInputElement).checked;

            if (!name || !middleSchool || !phone || !campus || !privacyChecked) {
                showError('필수 항목을 모두 입력해주세요.');
                return;
            }

            if (submitBtn) submitBtn.disabled = true;

            // 중복 연락처 확인
            const { data: existing } = await supabase
                .from('seminar_bookings')
                .select('id')
                .eq('phone', phone)
                .maybeSingle();

            if (existing) {
                if (submitBtn) submitBtn.disabled = false;
                showError('이미 신청하신 연락처입니다. 문의사항은 학원으로 연락해주세요.');
                return;
            }

            const { error } = await supabase.from('seminar_bookings').insert({
                campus,
                name,
                grade: `${middleSchool} (중3)`,
                phone,
                memo: targetHigh ? `관심고교: ${targetHigh}` : null,
                agree_privacy: true,
            });

            if (error) {
                if (submitBtn) submitBtn.disabled = false;
                showError('접수 중 오류가 발생했습니다. 잠시 후 다시 시도해주세요.');
                return;
            }

            if (submitBtn) submitBtn.disabled = false;
            openModal();
        });
    </script>
</body>
</html>
