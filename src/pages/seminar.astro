<!-- 예약 완료 모달 -->
<div id="successModal" class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/50 px-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 border border-gray-200 shadow-2xl text-center">
        <div class="w-16 h-16 rounded-full bg-brand-light text-brand-dark flex items-center justify-center mx-auto mb-4">
            <i data-lucide="check-circle-2" class="w-8 h-8"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">설명회 예약이 완료되었습니다</h3>
        <p id="successDesc" class="text-gray-600 text-sm mb-6 leading-relaxed"></p>
        <button id="modalCloseBtn" class="w-full py-3 rounded-xl bg-brand text-white font-bold hover:bg-brand-dark transition-colors text-sm">확인</button>
    </div>
</div>

<script is:inline>
    lucide.createIcons();
</script>

<script>
    import { supabase } from '../lib/supabase';

    // ── 예약 폼 ──
    const form = document.getElementById('bookingForm') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const errorEl = document.getElementById('formError');
    const modal = document.getElementById('successModal');
    const successDesc = document.getElementById('successDesc');

    const showError = (msg: string) => {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
    };

    function openModal(html: string) {
        if (successDesc) successDesc.innerHTML = html;
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
    }
    function closeModal() {
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
        form?.reset();
    }
    document.getElementById('modalCloseBtn')?.addEventListener('click', closeModal);

    // 전화번호 자동 하이픈
    document.getElementById('parentPhone')?.addEventListener('input', function (this: HTMLInputElement) {
        const val = this.value.replace(/[^0-9]/g, '');
        let res = '';
        if (val.length < 4) res = val;
        else if (val.length < 7) res = val.substr(0, 3) + '-' + val.substr(3);
        else if (val.length < 11) res = val.substr(0, 3) + '-' + val.substr(3, 3) + '-' + val.substr(6);
        else res = val.substr(0, 3) + '-' + val.substr(3, 4) + '-' + val.substr(7);
        this.value = res;
    });

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl?.classList.add('hidden');

        const checked = document.querySelector('input[name="selectedSeminar"]:checked') as HTMLInputElement | null;
        const campus = checked?.value;
        const target = checked?.dataset.target ?? '';
        const parentName = (document.getElementById('parentName') as HTMLInputElement).value.trim();
        const phone = (document.getElementById('parentPhone') as HTMLInputElement).value.trim();
        const studentName = (document.getElementById('studentName') as HTMLInputElement).value.trim();
        const school = (document.getElementById('schoolName') as HTMLInputElement).value.trim();
        const question = (document.getElementById('question') as HTMLTextAreaElement).value.trim();
        const privacyChecked = (document.getElementById('privacy') as HTMLInputElement).checked;

        if (!campus || !parentName || !phone || !studentName || !school || !privacyChecked) {
            showError('필수 항목을 모두 입력해주세요.');
            return;
        }

        if (submitBtn) submitBtn.disabled = true;

        // 같은 회차에 같은 연락처로 중복 신청 방지
        const { data: existing } = await supabase
            .from('seminar_bookings')
            .select('id')
            .eq('phone', phone)
            .eq('campus', campus)
            .limit(1);

        if (existing && existing.length > 0) {
            if (submitBtn) submitBtn.disabled = false;
            showError('이미 해당 회차에 신청하신 연락처입니다. 문의사항은 학원으로 연락해주세요.');
            return;
        }

        const { error } = await supabase.from('seminar_bookings').insert({
            campus,
            name: studentName,
            grade: `${school} (${target})`,
            phone,
            memo: `학부모: ${parentName}${question ? ' / 질문: ' + question : ''}`,
            agree_privacy: true,
        });

        if (submitBtn) submitBtn.disabled = false;

        if (error) {
            showError('접수 중 오류가 발생했습니다. 잠시 후 다시 시도해주세요.');
            return;
        }

        openModal(`<strong>${esc(parentName)}</strong> 학부모님, 예약 신청이 정상 접수되었습니다.<br><br><strong>${esc(campus)}</strong><br>좌석 배정 확정 문자가 기재하신 번호로 발송됩니다.`);
    });
</script>

</body>
</html>
