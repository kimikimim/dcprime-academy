---
import '../styles/global.css';
const pageTitle = "대치프라임학원 | 27학년도 대비 학부모 설명회 (예비중1·예비고1)";
const pageDesc = "내신 5등급제·통합형 수능·고교학점제 대비. 시흥 지역 12년 교육과정 지도 경험으로 예비중1(초6)·예비고1(중3) 학부모님께 학업 이정표를 제시합니다.";

const contextPoints = [
    {
        icon: 'scale',
        title: '내신 5등급제 개편의 본질',
        desc: '과목별 성취도 평가와 서술형·논술형 평가 비중이 확대되면서, 단편적인 암기보다 교과 개념에 대한 깊이 있는 이해와 성실한 과정 중심 학습 태도가 중요해졌습니다.',
    },
    {
        icon: 'route',
        title: '고교학점제 & 진로 설계',
        desc: '자유학기 활동을 바탕으로 관심과 적성을 발견하고, 중학교 3년간 기초 학력을 탄탄히 다져 고교 진학 후 주도적으로 과목을 선택할 수 있는 힘을 기릅니다.',
    },
    {
        icon: 'map-pin',
        title: '시흥 관내 고교 교육과정 안내',
        desc: '능곡고, 장곡고, 시흥고, 소래고, 함현고 등 학교별 교육과정 편제표와 특색 프로그램을 객관적으로 분석해 학생 성향에 맞는 고교 진로 탐색을 돕습니다.',
    },
];

const agendas = [
    {
        key: 'mid',
        label: 'TARGET 01',
        title: '예비 중1 (현 초6)',
        sub: '중등 전환기, 자기주도적 학습 습관의 형성',
        date: '11.13 (금)',
        time: '2시 장곡 / 7시 능곡',
        tone: 'brand',
        items: [
            { t: '중등 학습의 뼈대 세우기', d: '규칙적인 공부 리듬을 유지하고, 과목별 핵심 개념을 스스로 정리하는 중학 내신 적응 비법' },
            { t: '고교학점제 대비 시작점', d: '중등 3개년 교과 학습 로드맵 — 기본 개념 완성도 점검과 교과 심화 탐구의 균형 잡힌 학업 플랜' },
            { t: '대치프라임 밀착 관리 시스템', d: '스스로 오답을 정리하고 주간 학습 계획을 완수하는 건강한 자기주도 학습 습관 관리 방향' },
        ],
    },
    {
        key: 'high',
        label: 'TARGET 02',
        title: '예비 고1 (현 중3)',
        sub: '고교 진학 준비와 맞춤형 학업 설계도',
        date: '11.20 (금)',
        time: '2시 장곡 / 7시 능곡',
        tone: 'blue',
        items: [
            { t: '내신 5등급제와 통합형 수능, 위기인가 기회인가?', d: '2028 대입 개편안의 평가 기준 분석 및 교과 성취도와 수능 기초 체력을 조화롭게 다지는 학업 방향성' },
            { t: '시흥 관내 주요 고교 현미경 매치', d: '능곡·장곡·시흥·소래·함현 등 고교별 최근 입결 특징, 내신 난이도, 분위기, 선택과목 개설 현황 비교 분석' },
            { t: "'예비고1 하반기 로드맵' & 겨울방학 플랜", d: '고교 진학 전 탄탄한 기초 학업 역량을 빌딩할 국·수·영·과 전문 프로그램과 텐투텐 관리 소개, 고교선택 진단평가 안내' },
        ],
    },
];

const slots = [
    { value: '예비중1 · 장곡관 (11/13 14:00)', target: '예비중1 (현 초6)', campus: '장곡관', date: '11월 13일(금)', time: '오후 2:00', tone: 'brand' },
    { value: '예비중1 · 능곡관 (11/13 19:00)', target: '예비중1 (현 초6)', campus: '능곡관', date: '11월 13일(금)', time: '오후 7:00', tone: 'brand' },
    { value: '예비고1 · 장곡관 (11/20 14:00)', target: '예비고1 (현 중3)', campus: '장곡관', date: '11월 20일(금)', time: '오후 2:00', tone: 'blue' },
    { value: '예비고1 · 능곡관 (11/20 19:00)', target: '예비고1 (현 중3)', campus: '능곡관', date: '11월 20일(금)', time: '오후 7:00', tone: 'blue' },
];
---

<!DOCTYPE html>
<html lang="ko" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <script src="https://unpkg.com/lucide@latest" is:inline></script>
</head>
<body class="font-sans text-gray-800 bg-white antialiased">

<!-- Top Bar -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="text-lg font-bold tracking-tight text-gray-900">대치프라임학원</a>
        <a href="#reservation" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold bg-brand text-white hover:bg-brand-dark transition-colors">
            설명회 예약 <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
    </div>
</header>

<!-- Hero -->
<section class="bg-brand-light">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold text-brand-dark bg-white border border-brand/20 mb-6">
            <i data-lucide="graduation-cap" class="w-3.5 h-3.5"></i> 학생의 교육과 미래를 디자인합니다
        </span>
        <h1 class="text-2xl sm:text-4xl font-bold text-gray-900 leading-snug mb-6">
            변화하는 입시와 교육과정의 방향!<br class="hidden sm:block" />
            중·고등 <span class="text-brand-dark underline decoration-brand decoration-2 underline-offset-8">‘첫 단추’</span>가 아이의 올바른 성장을 이끕니다
        </h1>
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed mb-10">
            내신 5등급제와 통합형 수능, 그리고 고교학점제에 대한 현실적 대응.<br class="hidden sm:block" />
            시흥 지역 교육과정 12년의 연구와 지도 경험으로, 초6과 중3 학부모님께 학업 이정표를 제시합니다.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto mb-10 text-left">
            <a href="#schedule" class="block bg-white rounded-2xl p-5 border border-gray-200 border-l-4 border-l-brand shadow-sm hover:shadow-md transition">
                <span class="inline-block text-xs font-bold text-brand-dark bg-brand-light px-2.5 py-0.5 rounded mb-2">예비 중1 (현 초6)</span>
                <p class="text-lg font-extrabold text-gray-900">11월 13일 (금)</p>
                <p class="text-xs text-gray-500 mt-1">오후 2시(장곡관) · 오후 7시(능곡관)</p>
                <p class="text-xs text-gray-400 mt-2">중등 내신 적응 및 고교학점제 시작점 로드맵</p>
            </a>
            <a href="#schedule" class="block bg-white rounded-2xl p-5 border border-gray-200 border-l-4 border-l-blue-500 shadow-sm hover:shadow-md transition">
                <span class="inline-block text-xs font-bold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded mb-2">예비 고1 (현 중3)</span>
                <p class="text-lg font-extrabold text-gray-900">11월 20일 (금)</p>
                <p class="text-xs text-gray-500 mt-1">오후 2시(장곡관) · 오후 7시(능곡관)</p>
                <p class="text-xs text-gray-400 mt-2">내신 5등급제·통합수능 분석 및 관내 고교 교육과정 안내</p>
            </a>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="#reservation" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-bold bg-brand text-white hover:bg-brand-dark transition-colors shadow-sm">
                설명회 참가 신청하기 <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
            <a href="#sketch" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl font-semibold text-sm bg-white text-gray-700 border border-gray-200 hover:bg-gray-50 transition-colors">
                <i data-lucide="image" class="w-4 h-4 text-brand"></i> 지난 설명회 현장 보기
            </a>
        </div>
        <p class="text-xs text-gray-400 mt-4">원활한 진행을 위해 회차별 사전 신청 인원에 따라 좌석이 배정됩니다. (회차별 선착순 25명)</p>
    </div>
</section>

<!-- Poster -->
<section class="py-14 sm:py-20">
    <div class="max-w-md mx-auto px-4">
        <div class="rounded-2xl overflow-hidden shadow-xl border border-gray-100">
            <img src="/images/seminar-27-poster.jpg" alt="대치프라임 27학년도 대비 학부모 설명회 포스터 - 예비중1 11/13, 예비고1 11/20" class="w-full h-auto block" />
        </div>
        <a href="https://blog.naver.com/dcprime/224399658787" target="_blank" rel="noopener noreferrer"
           class="mt-4 flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-5 py-4 hover:border-brand hover:shadow-md transition">
            <span class="text-sm text-gray-700"><strong class="text-brand-dark">지난 설명회 리뷰</strong> 보러가기 — 실제 참석 후기를 확인하세요</span>
            <i data-lucide="arrow-up-right" class="w-5 h-5 text-brand flex-shrink-0"></i>
        </a>
    </div>
</section>

<!-- Key Context -->
<section class="py-16 sm:py-24 bg-gray-50 border-y border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="inline-block text-xs font-bold text-brand-dark bg-white px-3 py-1 rounded-full border border-brand/20 mb-3">Key Context</span>
            <h2 class="text-xl sm:text-3xl font-bold text-gray-900 leading-snug mb-3">
                새 교육과정의 출발점, <span class="text-brand-dark">‘예비중1’</span>과 <span class="text-blue-600">‘예비고1’</span>
            </h2>
            <p class="text-sm text-gray-500 leading-relaxed">
                교육과정 개편에 따라 초6과 중3은 새로운 평가 체제에 맞춰 체계적인 학습 습관과 학업 역량을 준비해야 하는 핵심 시기입니다.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {contextPoints.map((p) => (
                <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
                    <div class="w-11 h-11 rounded-xl bg-brand-light text-brand-dark flex items-center justify-center mb-4">
                        <i data-lucide={p.icon} class="w-5 h-5"></i>
                    </div>
                    <h3 class="text-base font-bold text-gray-900 mb-2">{p.title}</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">{p.desc}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Schedule / Agenda -->
<section id="schedule" class="py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="text-xs font-bold text-brand uppercase tracking-widest">Detailed Program</span>
            <h2 class="text-xl sm:text-3xl font-bold text-gray-900 mt-1 mb-3">설명회 핵심 아젠다 및 일정</h2>
            <p class="text-sm text-gray-500">초6과 중3의 전환기 학업 적응과 체계적인 학습 설계를 위한 세부 프로그램 안내입니다.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {agendas.map((a) => (
                <div class={`bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-sm border-t-4 flex flex-col justify-between ${a.tone === 'blue' ? 'border-t-blue-500' : 'border-t-brand'}`}>
                    <div>
                        <div class="flex items-center justify-between pb-5 border-b border-gray-100">
                            <div>
                                <span class={`text-xs font-extrabold px-2.5 py-1 rounded ${a.tone === 'blue' ? 'text-blue-700 bg-blue-50' : 'text-brand-dark bg-brand-light'}`}>{a.label}</span>
                                <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-2">{a.title}</h3>
                                <p class="text-xs text-gray-400 mt-1">{a.sub}</p>
                            </div>
                            <div class="text-right flex-shrink-0 ml-3">
                                <span class={`text-xl sm:text-2xl font-black block ${a.tone === 'blue' ? 'text-blue-600' : 'text-brand-dark'}`}>{a.date}</span>
                                <span class="text-xs text-gray-400">{a.time}</span>
                            </div>
                        </div>

                        <div class="space-y-3 my-6">
                            {a.items.map((it, i) => (
                                <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
                                    <div class={`flex items-center gap-2 font-bold text-sm mb-1 ${a.tone === 'blue' ? 'text-blue-700' : 'text-brand-dark'}`}>
                                        <span class={`w-6 h-6 rounded-md flex items-center justify-center text-xs ${a.tone === 'blue' ? 'bg-blue-100' : 'bg-brand-light'}`}>{i + 1}</span>
                                        <h4>{it.t}</h4>
                                    </div>
                                    <p class="text-xs sm:text-sm text-gray-500 pl-8 leading-relaxed">{it.d}</p>
                                </div>
                            ))}
                        </div>
                    </div>

                    <a href="#reservation" class={`w-full py-3.5 rounded-xl font-bold text-sm text-center block transition ${a.tone === 'blue' ? 'bg-blue-600 hover:bg-blue-700 text-white' : 'bg-brand hover:bg-brand-dark text-white'}`}>
                        {a.title.split(' ')[0] + ' ' + a.title.split(' ')[1]} 설명회 예약하기
                    </a>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Sketch -->
<section id="sketch" class="py-16 sm:py-24 bg-gray-50 border-y border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="inline-block text-xs font-bold text-brand-dark bg-white px-3 py-1 rounded-full border border-brand/20 mb-3">Live &amp; Records</span>
            <h2 class="text-xl sm:text-3xl font-bold text-gray-900 mb-3">대치프라임 설명회 현장 스케치</h2>
            <p class="text-sm text-gray-500">학부모님들의 뜨거운 열기와 현장의 분위기를 확인하세요.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
                <div class="aspect-[4/3] bg-gray-100">
                    <img src="/images/seminar-live-1.jpg" alt="대치프라임 입시설명회 현장" class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div class="p-4">
                    <p class="text-sm font-semibold text-gray-900">만석과 뜨거운 현장 열기</p>
                    <p class="text-xs text-gray-500 mt-0.5">장곡관 &amp; 능곡관 실제 설명회 전경</p>
                </div>
            </div>
            <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
                <div class="aspect-[4/3] bg-gray-100">
                    <img src="/images/hero-seminar.jpg" alt="지난 예비고1 선배 간담회 모습" class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div class="p-4">
                    <p class="text-sm font-semibold text-gray-900">선배 멘토와 함께한 간담회</p>
                    <p class="text-xs text-gray-500 mt-0.5">뜨거웠던 질문과 대화의 순간</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Speaker -->
<section id="director" class="py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-gray-50 rounded-3xl p-6 sm:p-10 border border-gray-100">
            <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
                <div class="flex-shrink-0 text-center">
                    <img src="https://smnakhjdtbqgwocwlluz.supabase.co/storage/v1/object/public/faculty-images/1783693029191.png"
                         alt="신성호 원장" class="w-36 h-36 sm:w-44 sm:h-44 rounded-full object-cover object-top border-4 border-white shadow-lg mx-auto mb-4 bg-gray-200" />
                    <span class="inline-block text-xs font-bold text-brand-dark bg-brand-light px-3 py-1 rounded-full">연사 [신성호 원장]</span>
                </div>

                <div class="flex-1 space-y-4 text-center md:text-left">
                    <div>
                        <p class="text-xs font-semibold text-gray-400">대치프라임 총괄 디렉터</p>
                        <h3 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mt-1">신성호 <span class="text-lg font-normal text-gray-500">원장</span></h3>
                        <p class="text-xs sm:text-sm text-brand-dark font-medium mt-1">
                            대치프라임 능곡관·장곡관 원장 | 입시컨설턴트 | 학원 전략 책임자
                        </p>
                    </div>

                    <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
                        "획일적인 입시 정보는 지역 학교의 특성과 개별 학생의 상황을 담아내지 못합니다. 우리 관내 고등학교의 교육과정과 평가 방식을 정확하게 이해하고 체계적으로 준비할 때 학생들의 역량이 가장 빛을 발할 수 있습니다. 이번 설명회에서 자녀의 균형 잡힌 학업 로드맵을 함께 나누겠습니다."
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-2 text-xs">
                        <div class="bg-white p-3 rounded-xl border border-gray-200 text-left">
                            <p class="text-brand-dark font-bold mb-0.5">10년 학생 지도</p>
                            <p class="text-gray-400 text-[11px]">시흥 관내 교육과정 특화 지도 경험 축적</p>
                        </div>
                        <div class="bg-white p-3 rounded-xl border border-gray-200 text-left">
                            <p class="text-brand-dark font-bold mb-0.5">학교별 교육과정 분석</p>
                            <p class="text-gray-400 text-[11px]">능곡·장곡·시흥·소래·함현 학사 일정 파악</p>
                        </div>
                        <div class="bg-white p-3 rounded-xl border border-gray-200 text-left">
                            <p class="text-brand-dark font-bold mb-0.5">1:1 맞춤 학습 클리닉</p>
                            <p class="text-gray-400 text-[11px]">개별 학생에 최적화된 공부 습관·과목 균형 지도</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Reservation -->
<section id="reservation" class="py-16 sm:py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
            <span class="text-xs font-bold text-brand uppercase tracking-widest">Reservation</span>
            <h2 class="text-xl sm:text-3xl font-bold text-gray-900 mt-1 mb-3">설명회 예약 신청</h2>
            <p class="text-sm text-gray-500">신청서를 작성해 주시면 확인 문자와 함께 좌석 배정 안내를 발송해 드립니다.</p>
        </div>

        <div class="bg-white rounded-2xl border border-rose-100 p-5 mb-8 text-center">
            <p class="text-sm text-gray-600"><strong class="text-rose-600">각 회차 25명 한정</strong> · 선착순으로 마감되며, 조기 마감될 수 있습니다.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-200 shadow-sm">
            <form id="bookingForm" class="space-y-6">
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-3">참석 희망 설명회 (택 1) <span class="text-rose-500">*</span></label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {slots.map((s, i) => (
                            <label class={`relative flex items-start gap-3 p-4 rounded-xl border border-gray-200 hover:bg-gray-50 transition cursor-pointer has-[:checked]:bg-gray-50 ${s.tone === 'blue' ? 'has-[:checked]:border-blue-500' : 'has-[:checked]:border-brand'}`}>
                                <input type="radio" name="selectedSeminar" value={s.value} data-target={s.target} required={i === 0}
                                       class={`mt-1 h-4 w-4 ${s.tone === 'blue' ? 'accent-blue-600' : 'accent-brand'}`} />
                                <div>
                                    <span class={`text-xs font-bold block ${s.tone === 'blue' ? 'text-blue-700' : 'text-brand-dark'}`}>{s.target}</span>
                                    <span class="text-sm font-bold text-gray-800 block mt-0.5">[{s.campus}] {s.date}</span>
                                    <span class="text-xs text-gray-500 block mt-0.5">{s.time}</span>
                                </div>
                            </label>
                        ))}
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label for="parentName" class="block text-xs font-bold text-gray-500 mb-2">학부모 성함 <span class="text-rose-500">*</span></label>
                        <input type="text" id="parentName" required placeholder="예: 김학부모" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors" />
                    </div>
                    <div>
                        <label for="parentPhone" class="block text-xs font-bold text-gray-500 mb-2">연락처 (안내 문자 수신용) <span class="text-rose-500">*</span></label>
                        <input type="tel" id="parentPhone" required pattern="[0-9]{2,3}-[0-9]{3,4}-[0-9]{4}" placeholder="010-0000-0000" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label for="studentName" class="block text-xs font-bold text-gray-500 mb-2">자녀 이름 <span class="text-rose-500">*</span></label>
                        <input type="text" id="studentName" required placeholder="예: 이프라임" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors" />
                    </div>
                    <div>
                        <label for="schoolName" class="block text-xs font-bold text-gray-500 mb-2">재학 학교 <span class="text-rose-500">*</span></label>
                        <input type="text" id="schoolName" required placeholder="예: 능곡초6, 장곡중3 등" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors" />
                    </div>
                </div>

                <div>
                    <label for="question" class="block text-xs font-bold text-gray-500 mb-2">평소 가장 궁금하셨던 입시·학습 질문 (선택)</label>
                    <textarea id="question" rows="3" placeholder="예: 주요 과목의 기초 개념 완성도가 고민입니다 / 고교학점제 선택과목은 어떻게 설계해야 하나요?" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-colors"></textarea>
                </div>

                <div class="flex items-start">
                    <input type="checkbox" id="privacy" required class="mt-1 w-4 h-4 rounded border-gray-300 accent-brand" />
                    <label for="privacy" class="ml-2 text-xs text-gray-500 leading-relaxed">
                        <strong class="text-gray-700">[필수] 개인정보 수집 및 이용 동의:</strong> 입력하신 정보는 설명회 좌석 배정 및 확인 문자 발송, 학원 입시 자료 제공 목적으로만 활용됩니다.
                    </label>
                </div>

                <p id="formError" class="text-sm text-red-500 hidden"></p>

                <button type="submit" id="submitBtn" class="w-full py-4 rounded-xl font-bold bg-brand text-white hover:bg-brand-dark transition-colors flex items-center justify-center gap-2 disabled:opacity-50">
                    설명회 좌석 예약하기 <i data-lucide="send" class="w-4 h-4"></i>
                </button>
            </form>
        </div>

        <div class="text-center text-sm text-gray-500 mt-8 space-y-1">
            <p>문의 및 사전예약</p>
            <p>📞 <strong class="text-gray-800">능곡관 :</strong> <a href="tel:031-313-0979" class="hover:text-brand transition-colors">031-313-0979</a> (시흥시 장현능곡로 178 5층)</p>
            <p>📞 <strong class="text-gray-800">장곡관 :</strong> <a href="tel:031-8042-4950" class="hover:text-brand transition-colors">031-8042-4950</a> (시흥시 장곡1로 11 4층 일부)</p>
        </div>
    </div>
</section>

<footer class="border-t border-gray-100 py-6 text-center text-xs text-gray-400">
    &copy; 2026 대치프라임학원. All Rights Reserved.
